---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Fab from '../components/Fab.astro';
import Hero from '../components/Hero.astro';
import Proof from '../components/Proof.astro';
import WhatIFix from '../components/WhatIFix.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import { copy } from '../content/copy';
---

<Base>
  <a class="skip" href="#work">{copy.nav.skip}</a>
  <Nav />
  <Fab />
  <Hero />
  <main id="main">
    <video class="wallfaint" muted loop playsinline preload="none" aria-hidden="true" tabindex="-1" poster="/img/wall-blur.webp"></video>
    <Proof />
    <WhatIFix />
    <About />
    <Contact />
  </main>
</Base>
