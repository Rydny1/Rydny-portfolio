---
import Navbar from '../components/Navbar';
import Footer from '../components/Footer.astro';
import ScrollToTop from '../components/ScrollToTop';
import '../styles/global.css';
// Self-hosted fonts (performance brief: self-hosted or fast CDN, font-display: swap —
// fontsource ships font-display: swap by default). No external font requests.
import '@fontsource-variable/fraunces';
import '@fontsource/plus-jakarta-sans/400.css';
import '@fontsource/plus-jakarta-sans/500.css';
import '@fontsource/plus-jakarta-sans/600.css';
import '@fontsource/plus-jakarta-sans/700.css';
import '@fontsource/noto-naskh-arabic/400.css';
import { withBase } from '../lib/base';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Rydny Ihims. Full-stack developer and AI builder.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={withBase('/assets/Rydny_logo.png')} />
    <title>{title}</title>
  </head>
  <body>
    <div class="page-intro" id="pageIntro" aria-hidden="true">
      <div class="page-intro__mark">
        <span class="page-intro__line"></span>
        <span class="page-intro__text">RYDNY IHIMS</span>
      </div>
    </div>

    <Navbar client:load />
    <main>
      <slot />
    </main>
    <Footer />
    <ScrollToTop client:visible />

    <script>
      import Lenis from 'lenis';

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let lenis: Lenis | null = null;

      if (!reduceMotion) {
        lenis = new Lenis({
          duration: 1.0,
          smoothWheel: true,
        });
        (window as any).__lenis = lenis;

        function raf(time: number) {
          lenis!.raf(time);
          requestAnimationFrame(raf);
        }
        requestAnimationFrame(raf);

        // Route same-page hash links through Lenis so anchor jumps match
        // the wheel-scroll feel instead of snapping natively.
        document.addEventListener('click', (e) => {
          const link = (e.target as HTMLElement)?.closest('a[href*="#"]');
          if (!link) return;
          const href = link.getAttribute('href') || '';
          const hashIndex = href.indexOf('#');
          if (hashIndex === -1) return;
          const hash = href.slice(hashIndex);
          const path = href.slice(0, hashIndex);
          if (path && path !== window.location.pathname) return;
          const target = document.querySelector(hash);
          if (!target) return;
          e.preventDefault();
          lenis!.scrollTo(target as HTMLElement, { duration: 1.0 });
        });
      }

      // Scroll reveal — fades in AND out as elements cross the viewport
      // (re-triggers both directions, never fire-once). Siblings sharing
      // a parent stagger by 40ms on the way in only.
      //
      // Driven by rect checks on Lenis's own scroll tick rather than an
      // IntersectionObserver: Lenis animates scroll independently of
      // native window.scrollY, and the observer's callback timing could
      // land out of step with what Lenis had actually drawn — an element
      // could sit fully out of view with is-visible still true. Reading
      // getBoundingClientRect() on the same tick Lenis uses to paint
      // removes that gap entirely.
      const revealEls = Array.from(document.querySelectorAll<HTMLElement>('.reveal, .fade-only, .hairline-draw'));
      const groups = new Map<Element, HTMLElement[]>();
      revealEls.forEach((el) => {
        if (!el.classList.contains('reveal') && !el.classList.contains('fade-only')) return;
        const parent = el.parentElement;
        if (!parent) return;
        if (!groups.has(parent)) groups.set(parent, []);
        groups.get(parent)!.push(el);
      });
      groups.forEach((children) => {
        children.forEach((el, i) => {
          el.style.setProperty('--stagger', `${i * 40}ms`);
        });
      });

      function checkReveal() {
        const vh = window.innerHeight;
        revealEls.forEach((el) => {
          const rect = el.getBoundingClientRect();
          // Plain "is any part of this on screen" — the earlier version
          // required an element to already be within the top 85% of the
          // viewport, meant to give scroll-triggered reveals a little
          // lead-in. It had a real side effect: anything sitting in the
          // bottom 15% of the viewport AT LOAD (the hero's CTA row on a
          // full-height hero, for instance) started hidden and only
          // appeared once the user scrolled it up past that line —
          // above-the-fold content should never need a scroll to show up.
          const visible = rect.bottom > 0 && rect.top < vh;
          el.classList.toggle('is-visible', visible);
        });
      }
      checkReveal();
      if (lenis) {
        lenis.on('scroll', checkReveal);
      } else {
        window.addEventListener('scroll', checkReveal, { passive: true });
      }
      window.addEventListener('resize', checkReveal);
    </script>
  </body>
</html>

<style>
  /* Page-load intro — pure CSS, no JS dependency, so it can never be the
     thing that makes the site feel slow. Skips entirely for
     prefers-reduced-motion, and blocks interaction only for its own
     brief run (visibility: hidden at the end removes it from hit-testing). */
  .page-intro {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-dark);
    animation: intro-fade 1.7s var(--ease) forwards;
  }

  .page-intro__mark {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .page-intro__line {
    display: block;
    width: 0;
    height: 1px;
    background: var(--accent);
    animation: intro-line 0.7s var(--ease) 0.15s forwards;
  }

  .page-intro__text {
    font-size: var(--fs-14);
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--text-on-dark);
    opacity: 0;
    transform: translateY(8px);
    animation: intro-text 0.6s var(--ease) 0.5s forwards;
  }

  @keyframes intro-line {
    to {
      width: 64px;
    }
  }

  @keyframes intro-text {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes intro-fade {
    0%,
    65% {
      opacity: 1;
      visibility: visible;
    }
    100% {
      opacity: 0;
      visibility: hidden;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-intro {
      display: none;
    }
  }
</style>
