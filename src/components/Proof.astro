---
import { copy } from '../content/copy';
import { projects } from '../content/projects';
import Project from './Project.astro';
const { proof } = copy;
---

<section class="proof" id="work" aria-labelledby="proof-title" data-node>
  <div class="wrap">
    <div class="head">
      <h2 id="proof-title" data-title data-drift="1">{proof.title}<span class="fs">.</span></h2>
      <p class="lead" data-words>{proof.lead}</p>
    </div>
  </div>

  <div class="wrap rail-wrap">
    <section class="rail" data-rail tabindex="0" aria-label="Projects, swipe or scroll sideways">
      {projects.map((p) => <Project project={p} />)}
    </section>
    <div class="progress" aria-hidden="true">
      <span class="count"><b data-rail-now>01</b> / {String(projects.length).padStart(2, '0')}</span>
      <span class="track"><i data-rail-bar></i></span>
    </div>
  </div>

  <div class="wrap">
    <p class="more">
      {proof.more.prefix}{' '}
      {proof.more.items.map((m, i) => (
        <>
          {i > 0 && ', '}
          <a class="link" href={m.href} rel="noopener">{m.label}</a>
        </>
      ))}
    </p>
  </div>
</section>

<style>
  .proof {
    padding: 120px 0;
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--s-4);
    margin-bottom: 64px;
  }
  h2 {
    color: var(--green);
    font-size: var(--fs-h2);
    line-height: 0.82;
    font-weight: 560;
    letter-spacing: -0.03em;
  }
  .lead {
    font-size: 20px;
    max-width: 24ch;
  }
  .progress {
    display: none;
  }
  .more {
    border-top: 1px solid rgb(46 70 54 / 0.2);
    padding-top: var(--s-4);
    font-size: 16px;
    color: var(--mist);
  }
  .more :global(a) {
    color: var(--ink);
  }

  @media (max-width: 899px) {
    .proof {
      padding: var(--section-y) 0;
    }
    .head {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--s-2);
      margin-bottom: var(--s-4);
    }
    .rail-wrap {
      padding-inline: 0;
    }
    .rail {
      display: flex;
      gap: var(--s-2);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--pad);
      padding-inline: var(--pad);
      padding-bottom: var(--s-1);
      overscroll-behavior-x: contain;
      scrollbar-width: none;
    }
    .rail::-webkit-scrollbar {
      display: none;
    }
    .progress {
      display: flex;
      align-items: center;
      gap: var(--s-2);
      margin: var(--s-3) var(--pad) 0;
      font-size: 12px;
      letter-spacing: 0.1em;
      color: var(--mist);
    }
    .count b {
      color: var(--ink);
      font-weight: 600;
    }
    .track {
      position: relative;
      flex: 1;
      height: 2px;
      background: rgb(46 70 54 / 0.25);
      overflow: hidden;
    }
    .track i {
      position: absolute;
      inset: 0;
      background: var(--signal);
      transform-origin: left;
      transform: scaleX(0.34);
      transition: transform 0.2s linear;
    }
    .more {
      margin-top: var(--s-4);
    }
  }
</style>

<script>
  // Phones: the orange progress line under the swipe carousel
  const rail = document.querySelector<HTMLElement>('[data-rail]');
  const bar = document.querySelector<HTMLElement>('[data-rail-bar]');
  const now = document.querySelector<HTMLElement>('[data-rail-now]');
  if (rail && bar && now) {
    const cards = Array.from(rail.children) as HTMLElement[];
    let ticking = false;
    const update = () => {
      ticking = false;
      const max = rail.scrollWidth - rail.clientWidth;
      const p = max > 0 ? rail.scrollLeft / max : 0;
      bar.style.transform = `scaleX(${(1 / cards.length + p * (1 - 1 / cards.length)).toFixed(3)})`;
      now.textContent = String(Math.min(cards.length, Math.round(p * (cards.length - 1)) + 1)).padStart(2, '0');
    };
    rail.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }
</script>
