---
import { copy } from '../content/copy';
import { projects } from '../content/projects';
import Project from './Project.astro';
const { proof } = copy;
---

<section class="proof" id="work" aria-labelledby="proof-title" data-node>
  <div class="wrap">
    <div class="head">
      <h2 id="proof-title" data-title data-drift="1">{proof.title}<span class="fs">.</span></h2>
      <p class="lead" data-words>{proof.lead}</p>
    </div>
  </div>

  <div class="wrap rail-wrap">
    <section class="rail" data-rail tabindex="0" aria-label="Projects, swipe or scroll sideways">
      {projects.map((p) => <Project project={p} />)}
    </section>
    <div class="progress" aria-hidden="true" data-total={projects.length}>
      <span class="count"><b data-rail-now>01</b> / {String(projects.length).padStart(2, '0')}</span>
      <span class="track"><i data-rail-bar></i></span>
    </div>
  </div>
</section>

<style>
  .proof {
    padding: 120px 0;
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--s-4);
    margin-bottom: 64px;
  }
  h2 {
    color: var(--green);
    font-size: var(--fs-h2);
    line-height: 0.82;
    font-weight: 560;
    letter-spacing: -0.03em;
  }
  .lead {
    font-size: 20px;
    max-width: 24ch;
  }
  .progress {
    display: none;
  }

  @media (max-width: 899px) {
    .proof {
      padding: var(--section-y) 0;
    }
    .head {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--s-2);
      margin-bottom: var(--s-4);
    }
    .rail-wrap {
      padding-inline: 0;
    }
    .rail {
      display: flex;
      gap: var(--s-2);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--pad);
      padding-inline: var(--pad);
      padding-bottom: var(--s-1);
      align-items: flex-start;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
    }
    .rail::-webkit-scrollbar {
      display: none;
    }
    .progress {
      display: flex;
      align-items: center;
      gap: var(--s-2);
      margin: var(--s-3) var(--pad) 0;
      font-size: 12px;
      letter-spacing: 0.1em;
      color: var(--mist);
    }
    .count b {
      color: var(--ink);
      font-weight: 600;
    }
    .track {
      position: relative;
      flex: 1;
      height: 2px;
      background: rgb(46 70 54 / 0.25);
      overflow: hidden;
    }
    .track i {
      position: absolute;
      inset: 0;
      background: var(--signal);
      transform-origin: left;
      transform: scaleX(0.34);
      transition: transform 0.2s linear;
    }
  }
</style>

<script>
  // Phones: the orange progress line under the swipe carousel
  const rail = document.querySelector<HTMLElement>('[data-rail]');
  const bar = document.querySelector<HTMLElement>('[data-rail-bar]');
  const now = document.querySelector<HTMLElement>('[data-rail-now]');
  if (rail && bar && now) {
    const total = Number(rail.parentElement?.querySelector<HTMLElement>('.progress')?.dataset.total) || rail.children.length;
    let ticking = false;
    const update = () => {
      ticking = false;
      const max = rail.scrollWidth - rail.clientWidth;
      const p = max > 0 ? Math.min(1, Math.max(0, rail.scrollLeft / max)) : 0; // clamped: rubber-banding never overshoots
      const idx = Math.min(total, Math.max(1, Math.round(p * (total - 1)) + 1));
      bar.style.transform = `scaleX(${(1 / total + p * (1 - 1 / total)).toFixed(3)})`;
      now.textContent = String(idx).padStart(2, '0');
    };
    const queue = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    rail.addEventListener('scroll', queue, { passive: true });
    addEventListener('resize', queue);
    update();
  }
</script>
