---
import type { Project } from '../content/projects';
import { copy } from '../content/copy';
import Pic from './Pic.astro';
import MiniFlow from './MiniFlow.astro';

interface Props {
  project: Project;
}
const { project: p } = Astro.props;
const L = copy.proof.labels;
const primary = p.links[0];
// 16:10 unless the source is wider (then it is shown whole, never cropped through text)
const wide = p.image.width / p.image.height > 1.7;
const ratio = wide ? `${p.image.width} / ${p.image.height}` : '16 / 10';
---

<article class="project" aria-labelledby={`p-${p.slug}`}>
  <div class="media">
    <div class="shot" style={`aspect-ratio:${ratio}`} data-wipe data-tone={p.tone}>
      {primary ? (
        <a href={primary.href} rel="noopener" data-cursor="View project" aria-label={`${p.name}: ${primary.label}`}>
          {p.video ? (
            <video class="loop" muted loop playsinline preload="none" poster={`/img/${p.image.src}.webp`} data-webm={p.video.webm} data-mp4={p.video.mp4} aria-label={p.image.alt}></video>
          ) : (
            <Pic base={p.image.src} alt={p.image.alt} width={p.image.width} height={p.image.height} sizes="(min-width: 900px) 58vw, 86vw" />
          )}
        </a>
      ) : (
        <Pic base={p.image.src} alt={p.image.alt} width={p.image.width} height={p.image.height} sizes="(min-width: 900px) 58vw, 86vw" />
      )}
    </div>
  </div>

  <div class="text">
    <div class="meta" data-reveal>
      {p.badge ? <span class="badge">{p.badge}</span> : <span class="label">{p.label}</span>}
      <h3 id={`p-${p.slug}`}>{p.name}</h3>
    </div>
    <dl data-reveal data-delay="80">
      <dt>{L.problem}</dt><dd>{p.problem}</dd>
      <dt>{L.fix}</dt><dd>{p.fix}</dd>
      <dt>{L.result}</dt><dd>{p.result}</dd>
    </dl>
    <MiniFlow steps={p.flow} />
    <p class="more-line">{copy.proof.ask.text} <a class="ask" href={copy.proof.ask.href}>{copy.proof.ask.label}</a></p>
    {p.links.length > 0 && (
      <ul class="links">
        {p.links.map((l) => (
          <li><a class="link" href={l.href} rel="noopener">{l.label}</a></li>
        ))}
      </ul>
    )}
  </div>
</article>

<style>
  .project {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 56px;
    align-items: start;
    padding: 44px 0;
    border-top: 1px solid rgb(46 70 54 / 0.2);
  }
  .shot {
    overflow: hidden;
    border-radius: 6px;
    background: #111;
    box-shadow: 0 30px 60px -30px rgb(46 70 54 / 0.55);
  }
  .shot a {
    display: block;
    height: 100%;
  }
  .shot :global(picture),
  .shot :global(video) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .shot :global(img),
  .shot :global(video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 0.9s var(--ease);
  }
  @media (hover: hover) {
    .shot a:hover :global(img),
    .shot a:focus-visible :global(img),
    .shot a:hover :global(video) {
      transform: scale(1.04);
    }
  }
  .meta {
    margin-bottom: 24px;
  }
  h3 {
    font-size: 48px;
    line-height: 1;
    font-weight: 540;
    color: var(--ink);
    margin: 14px 0 0;
  }
  .badge {
    display: inline-block;
    background: var(--green);
    color: var(--paper);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 6px 11px;
    border-radius: var(--radius-pill);
  }
  dl {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 10px 16px;
    font-size: 17px;
  }
  dt {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--ink);
    opacity: 0.5;
    padding-top: 5px;
  }
  dd {
    font-size: 17px;
    line-height: 1.6;
  }
  .more-line {
    margin-top: 20px;
    font-size: 15px;
    font-weight: 600;
  }
  .ask {
    text-decoration: underline;
    text-decoration-color: var(--signal);
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }
  .links {
    display: flex;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }

  /* Phones: each project is a card inside the swipe carousel */
  @media (max-width: 899px) {
    .project {
      display: block;
      flex: 0 0 86%;
      scroll-snap-align: start;
      border: 1px solid rgb(46 70 54 / 0.25);
      border-radius: 6px;
      background: #f5f1ea;
      padding: var(--s-2);
    }
    .shot {
      box-shadow: none;
    }
    .text {
      padding: var(--s-3) 0 var(--s-1);
    }
    .meta {
      margin-bottom: var(--s-2);
    }
    .badge {
      font-size: 9.5px;
      letter-spacing: 0.1em;
      padding: 4px 10px;
    }
    h3 {
      font-size: 32px;
      margin-top: var(--s-1);
    }
    dl {
      grid-template-columns: 1fr;
      gap: 0;
    }
    dt {
      padding-top: var(--s-1);
    }
    dd {
      font-size: 14px;
      line-height: 1.5;
    }
    .more-line {
      margin-top: var(--s-2);
      font-size: 13px;
    }
  }
</style>
