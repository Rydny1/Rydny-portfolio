---
import '../styles/wire.css';
import { copy } from '../content/copy';
const { hero } = copy;
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <picture class="poster">
    <source type="image/avif" srcset="/img/wall-poster-800.avif 800w, /img/wall-poster.avif 1600w" sizes="100vw" />
    <source type="image/webp" srcset="/img/wall-poster-800.webp 800w, /img/wall-poster.webp 1600w" sizes="100vw" />
    <img src="/img/wall-poster.jpg" alt="" width="1600" height="900" fetchpriority="high" decoding="async" />
  </picture>
  <video class="wall" muted loop playsinline preload="none" aria-hidden="true" tabindex="-1" poster="/img/wall-poster.jpg"></video>
  <img class="blur" src="/img/wall-blur.webp" alt="" aria-hidden="true" width="800" height="450" decoding="async" />
  <div class="veil" aria-hidden="true"></div>

  <svg class="wire" aria-hidden="true" focusable="false" data-steps={JSON.stringify(hero.steps)}>
    <defs>
      <linearGradient id="capsule" x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-opacity="0"></stop>
        <stop offset="0.5" stop-opacity="1"></stop>
        <stop offset="1" stop-opacity="0"></stop>
      </linearGradient>
      <linearGradient id="capsule-glow" x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-opacity="0"></stop>
        <stop offset="0.5" stop-opacity="1"></stop>
        <stop offset="1" stop-opacity="0"></stop>
      </linearGradient>
      <filter id="soft" x="-50%" y="-200%" width="200%" height="500%"><feGaussianBlur stdDeviation="2.5"></feGaussianBlur></filter>
    </defs>
    <path class="track" pathLength="1"></path>
    <path class="line" pathLength="1"></path>
    <g class="lights"></g>
    <g class="pills"></g>
    <g class="start"></g>
    <g class="end"></g>
  </svg>

  <div class="inner">
    <h1 id="hero-title">
      <span class="l1">{hero.line1}<span class="stop" data-wire-start>.</span></span>
      <span class="l2"><em><span class="b" data-wire-end>B</span>uild the fix.</em></span>
    </h1>

    <div class="bottom">
      <div class="lead-block">
        <p class="lead">{hero.lead}</p>
        <div class="cta">
          <a class="btn" href={hero.primary.href} data-magnetic>{hero.primary.label}</a>
          <a class="link" href={hero.secondary.href}>{hero.secondary.label}</a>
        </div>
      </div>
      <ul class="facts">
        {hero.facts.map((f) => (
          <li><b>{f.title}</b><span>{f.text}</span></li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    position: sticky;
    top: 0;
    z-index: 0;
    min-height: 100svh;
    overflow: hidden;
    isolation: isolate;
    background: var(--paper);
  }
  .poster,
  .poster img,
  .wall {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .poster {
    z-index: -3;
  }
  .wall {
    z-index: -2;
    opacity: 0;
  }
  .wall.ready {
    opacity: 1;
  }
  /* Pre-blurred wall: its opacity rises as the page slides over the hero. */
  .blur {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
  }
  .veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(90deg, rgb(246 241 234 / 0.5), rgb(246 241 234 / 0.2) 60%, transparent 80%), rgb(140 160 128 / 0.16);
  }
  .inner {
    position: relative;
    z-index: 2;
    min-height: 100svh;
    max-width: var(--max);
    margin-inline: auto;
    padding: clamp(120px, round(17vh, 8px), 160px) var(--pad) var(--s-6);
    display: flex;
    flex-direction: column;
  }
  h1 {
    color: var(--green);
    font-size: var(--fs-hero);
    font-weight: 380;
    letter-spacing: -0.045em;
    line-height: 0.95;
    display: flex;
    flex-direction: column;
    flex: 1;
    text-wrap: nowrap;
  }
  .l1 {
    align-self: flex-start;
  }
  .l2 {
    align-self: flex-end;
    margin-top: auto;
    margin-bottom: clamp(var(--s-6), round(17vh, 8px), 160px);
  }
  .l2 em {
    font-style: italic;
    font-weight: 340;
  }
  .bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--s-6);
    margin-top: var(--s-3);
  }
  .lead {
    font-size: var(--fs-lead);
    line-height: 1.5;
    max-width: 34ch;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-4);
    margin-top: var(--s-3);
  }
  .facts {
    display: flex;
    gap: var(--s-6);
  }
  .facts li {
    display: flex;
    flex-direction: column;
    font-size: var(--fs-meta);
    font-weight: 500;
  }
  .facts b {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--fs-fact);
    letter-spacing: -0.01em;
  }

  /* Desktop: the hero is exactly one screen. Type scales with the smaller of width and height. */
  @media (min-width: 900px) {
    .hero {
      height: max(100svh, 540px);
      min-height: 0;
    }
    .inner {
      height: 100%;
      min-height: 0;
      padding-bottom: clamp(var(--s-3), round(5vh, 8px), var(--s-6));
    }
    h1 {
      font-size: clamp(52px, min(7.4vw, 13vh), 128px);
    }
  }

  @media (max-width: 899px) {
    h1 {
      font-size: clamp(44px, 13.5vw, 96px);
      text-wrap: balance;
    }
    .l1,
    .l2 {
      align-self: flex-start;
    }
    .l1 {
      margin-bottom: var(--s-8);
    }
    .l2 {
      margin-bottom: 0;
    }
    .inner {
      padding-top: var(--s-16);
      padding-bottom: var(--s-3);
    }
    .bottom {
      flex-direction: column;
      align-items: stretch;
      gap: var(--s-3);
      margin-top: var(--s-4);
    }
    .lead {
      font-size: 18px;
    }
    .cta {
      margin-top: var(--s-2);
    }
    .facts {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--s-3);
    }
    .facts li {
      font-size: var(--fs-label);
      line-height: 1.35;
    }
    .facts b {
      font-size: 17px;
      line-height: 1.2;
      margin-bottom: 4px;
    }
  }

  /* Load sequence (1.6s base, every duration and delay x --k). Plays once per session.
     Pure CSS, so nothing can stay hidden if a script fails. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js:not(.seen)) .l1 {
      animation: rise calc(0.55s * var(--k)) var(--ease) both;
    }
    :global(html.js:not(.seen)) .l2 {
      animation: rise calc(0.45s * var(--k)) var(--ease) calc(1.15s * var(--k)) both;
    }
    :global(html.js:not(.seen)) .lead-block,
    :global(html.js:not(.seen)) .facts {
      animation: fade-up calc(0.4s * var(--k)) var(--ease) calc(1.2s * var(--k)) both;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
</style>

<script>
  import '../scripts/hero-wire';

  const hero = document.querySelector<HTMLElement>('.hero');
  const v = document.querySelector<HTMLVideoElement>('.hero .wall');
  const blur = document.querySelector<HTMLElement>('.hero .blur');
  const inner = document.querySelector<HTMLElement>('.hero .inner');
  const wire = document.querySelector<SVGElement>('.hero .wire');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const conn = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
  const posterOnly = reduced || !!conn?.saveData || /^(slow-2g|2g|3g)$/.test(conn?.effectiveType ?? '');

  let tabVisible = true;
  const sync = () => {
    if (!v || reduced) return;
    const covered = scrollY > innerHeight * 1.1;
    if (tabVisible && !document.hidden && !covered) v.play().catch(() => {});
    else v.pause();
  };

  // The hero stays pinned; the page slides over it. As it does, the wall blurs and the type eases away.
  // Only opacity and transform change: the blur is a pre-blurred image fading in, never a live filter.
  let ticking = false;
  const onScroll = () => {
    ticking = false;
    if (!hero) return;
    const p = Math.min(1, Math.max(0, scrollY / (innerHeight * 0.9)));
    // The line and pills go with the wall: 0 to 60% of the hero, one element blurred up to 6px.
    const lp = Math.min(1, Math.max(0, scrollY / (hero.offsetHeight * 0.6)));
    if (blur) blur.style.opacity = String(p);
    if (inner) {
      inner.style.opacity = String(Math.max(0, 1 - p * 2.4));
      inner.style.transform = p ? `translateY(${(-p * 32).toFixed(1)}px)` : '';
    }
    if (wire) {
      wire.style.opacity = String(1 - lp);
      wire.style.filter = lp > 0.02 ? `blur(${(lp * 6).toFixed(2)}px)` : '';
    }
    sync();
  };
  addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(onScroll);
      }
    },
    { passive: true },
  );

  if (v && !posterOnly) {
    // phones get the 720p cut (under 1 MB); everything else the full-size one
    const small = matchMedia('(max-width: 899px)').matches;
    for (const [type, ext] of [['video/webm', 'webm'], ['video/mp4', 'mp4']] as const) {
      const src = document.createElement('source');
      src.src = `/video/wall-light${small ? '-720' : ''}.${ext}`;
      src.type = type;
      v.append(src);
    }
    v.addEventListener('playing', () => v.classList.add('ready'), { once: true });
    new IntersectionObserver(([e]) => {
      tabVisible = !!e?.isIntersecting;
      sync();
    }).observe(v);
    document.addEventListener('visibilitychange', sync);
    v.load();
    sync();
  }
  onScroll();
</script>
