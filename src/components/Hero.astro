---
import HeroVisual from './hero/HeroVisual';
import GlassButton from './GlassButton';

// Breathing ambient background — spread across the edges/corners so it
// stays visible without sitting behind the text or the Prism.
const bgShapes = [
  { top: '8%', left: '3%', w: 90, h: 90, color: 'pewter', op: 0.34, dur: 16, delay: -2, lightDur: 9, lightDelay: -1 },
  { top: '78%', left: '5%', w: 150, h: 95, color: 'pewter', op: 0.3, dur: 19, delay: -9, lightDur: 12, lightDelay: -6 },
  { top: '6%', left: '90%', w: 70, h: 70, color: 'brushed', op: 0.32, dur: 14, delay: -4, lightDur: 8, lightDelay: -3 },
  { top: '85%', left: '88%', w: 110, h: 70, color: 'pewter', op: 0.28, dur: 22, delay: -15, lightDur: 17, lightDelay: -13 },
  { top: '45%', left: '1%', w: 60, h: 60, color: 'brushed', op: 0.3, dur: 17, delay: -7, lightDur: 10, lightDelay: -5 },
  { top: '30%', left: '96%', w: 55, h: 55, color: 'pewter', op: 0.3, dur: 15, delay: -5, lightDur: 8.5, lightDelay: -2 },
  { top: '92%', left: '40%', w: 85, h: 85, color: 'brushed', op: 0.28, dur: 20, delay: -11, lightDur: 13, lightDelay: -8 },
  { top: '2%', left: '45%', w: 65, h: 65, color: 'pewter', op: 0.26, dur: 18, delay: -3, lightDur: 11, lightDelay: -6 },
  { top: '55%', left: '94%', w: 100, h: 65, color: 'pewter', op: 0.27, dur: 21, delay: -16, lightDur: 14, lightDelay: -10 },
];
---

<section class="hero theme-dark" id="home">
  <div class="hero__ambient" aria-hidden="true">
    {
      bgShapes.map((s) => (
        <div
          class={`bg-shape bg-shape--${s.color}`}
          style={`top:${s.top}; left:${s.left}; width:${s.w}px; height:${s.h}px; --op:${s.op}; --dur:${s.dur}s; --delay:${s.delay}s; --light-dur:${s.lightDur}s; --light-delay:${s.lightDelay}s;`}
        />
      ))
    }
  </div>
  <div class="container hero__inner">
    <div class="hero__content">
      <p class="hero__badge load-reveal" style="--delay: 0ms">Available for work. Riga and remote.</p>

      <h1 class="hero__name">
        <span class="load-reveal-mask" style="--delay: 60ms"><span class="load-reveal-text">Rydny Ihims</span></span>
      </h1>

      <p class="hero__role">
        <span class="load-reveal-mask" style="--delay: 200ms"
          ><span class="load-reveal-text">I build web products and AI systems</span></span
        >
      </p>

      <p class="hero__bio load-reveal" style="--delay: 320ms">
        Full-stack developer and AI builder. I take an idea and turn it into a working product.
      </p>

      <div class="hero__cta load-reveal" style="--delay: 400ms">
        <GlassButton href="#work" client:visible>See the work</GlassButton>
        <a href="mailto:rydny01@gmail.com" class="hero__email-link">Or email me</a>
      </div>
    </div>

    <div class="hero__visual load-reveal" style="--delay: 260ms">
      <HeroVisual client:visible />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-top: var(--nav-h);
    overflow: hidden;
    background: var(--bg);
    color: var(--text);
  }

  .hero__ambient {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  @property --angle {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }

  .bg-shape {
    position: absolute;
    border: 1px solid var(--pewter);
    opacity: var(--op);
    animation: bg-breathe var(--dur) ease-in-out var(--delay) infinite alternate;
    will-change: opacity, transform;
  }

  .bg-shape--brushed {
    border-color: var(--brushed);
  }

  /* A bright segment travels once around this shape's own perimeter,
     independently timed per shape — light passing through the line,
     not a synchronized sweep across all of them. */
  .bg-shape::before {
    content: '';
    position: absolute;
    inset: -1px;
    --angle: 0deg;
    padding: 1.5px;
    background: conic-gradient(from var(--angle), transparent 0deg, var(--porcelain) 11deg, transparent 24deg);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 1;
    filter: drop-shadow(0 0 3px rgba(245, 241, 232, 1)) drop-shadow(0 0 9px rgba(245, 241, 232, 0.8));
    animation: light-travel var(--light-dur) linear var(--light-delay) infinite;
  }

  .bg-shape--brushed::before {
    background: conic-gradient(from var(--angle), transparent 0deg, var(--brushed) 11deg, transparent 24deg);
    filter: drop-shadow(0 0 3px rgba(180, 184, 188, 1)) drop-shadow(0 0 9px rgba(180, 184, 188, 0.8));
  }

  @keyframes bg-breathe {
    from {
      opacity: calc(var(--op) * 0.35);
      transform: scale(1);
    }
    to {
      opacity: var(--op);
      transform: scale(1.035);
    }
  }

  @keyframes light-travel {
    to {
      --angle: 360deg;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bg-shape {
      animation: none;
      opacity: calc(var(--op) * 0.7);
    }

    .bg-shape::before {
      animation: none;
      opacity: 0;
    }
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr;
    gap: 56px;
    align-items: center;
    padding-block: 64px;
  }

  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 40px;
    }
  }

  .hero__badge {
    display: inline-block;
    font-size: var(--fs-12);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin-bottom: 24px;
  }

  .hero__name {
    font-family: var(--font-display);
    font-size: var(--fs-hero);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--text);
    margin-bottom: 20px;
  }

  .hero__role {
    font-family: var(--font-display);
    font-size: clamp(var(--fs-22), 2vw + 0.5rem, var(--fs-28));
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: 20px;
  }

  .hero__bio {
    font-size: var(--fs-16);
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 60ch;
    margin-bottom: 40px;
  }

  .hero__cta {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .hero__email-link {
    font-size: var(--fs-14);
    color: var(--text-secondary);
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }

  .hero__email-link:hover {
    color: var(--text);
    border-color: var(--accent-ui);
  }

  .hero__visual {
    order: -1;
  }

  /* Mobile — close to one viewport on load without cramming everything
     together. A little scroll is better than losing the organized,
     spaced-out feel entirely. */
  @media (max-width: 480px) {
    .hero {
      min-height: 100svh;
      padding-top: calc(var(--nav-h) + 16px);
    }

    .hero__inner {
      gap: 40px;
      padding-block: 24px;
    }

    .hero__badge {
      font-size: 11px;
      margin-bottom: 20px;
    }

    .hero__name {
      font-size: 2.6rem;
      margin-bottom: 20px;
    }

    .hero__role {
      font-size: 1.05rem;
      margin-bottom: 18px;
    }

    .hero__bio {
      font-size: 14px;
      line-height: 1.6;
      margin-bottom: 32px;
    }

    .hero__cta {
      gap: 20px;
    }
  }

  @media (min-width: 900px) {
    .hero__visual {
      order: 0;
    }
  }

  /* ============================================================
     ONE-TIME LOAD REVEAL — "instrument settle". Plays once on
     first paint only; nothing here ever loops.
  ============================================================ */
  .load-reveal {
    opacity: 0;
    transform: translateY(14px);
    animation: reveal-fade 1000ms var(--ease) forwards;
    animation-delay: var(--delay, 0ms);
  }

  .load-reveal-mask {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
  }

  .load-reveal-text {
    display: inline-block;
    clip-path: inset(0 100% 0 0);
    animation: reveal-wipe 1000ms var(--ease) forwards;
    animation-delay: var(--delay, 0ms);
  }

  @keyframes reveal-fade {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes reveal-wipe {
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .load-reveal,
    .load-reveal-text {
      animation: none;
      opacity: 1;
      transform: none;
      clip-path: inset(0 0 0 0);
    }
  }
</style>
