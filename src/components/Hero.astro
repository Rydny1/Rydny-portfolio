---
import '../styles/wire.css';
import { copy } from '../content/copy';
const { hero } = copy;
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <picture class="poster">
    <source type="image/avif" srcset="/img/wall-poster-800.avif 800w, /img/wall-poster.avif 1600w" sizes="100vw" />
    <source type="image/webp" srcset="/img/wall-poster-800.webp 800w, /img/wall-poster.webp 1600w" sizes="100vw" />
    <img src="/img/wall-poster.jpg" alt="" width="1600" height="900" fetchpriority="high" decoding="async" />
  </picture>
  <video class="wall" muted loop playsinline preload="none" aria-hidden="true" tabindex="-1" poster="/img/wall-poster.jpg"></video>
  <img class="blur" src="/img/wall-blur.webp" alt="" aria-hidden="true" width="800" height="450" decoding="async" />
  <div class="veil" aria-hidden="true"></div>

  <svg class="wire" aria-hidden="true" focusable="false" data-steps={JSON.stringify(hero.steps)}>
    <defs>
      <linearGradient id="capsule" x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-opacity="0"></stop>
        <stop offset="0.5" stop-opacity="1"></stop>
        <stop offset="1" stop-opacity="0"></stop>
      </linearGradient>
      <linearGradient id="capsule-glow" x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-opacity="0"></stop>
        <stop offset="0.5" stop-opacity="1"></stop>
        <stop offset="1" stop-opacity="0"></stop>
      </linearGradient>
    </defs>
    <path class="track" pathLength="1"></path>
    <path class="line" pathLength="1"></path>
    <g class="lights"></g>
    <g class="pills"></g>
    <g class="start"></g>
    <g class="end"></g>
  </svg>

  <h1 id="hero-title" class="big">
    <span class="l1">{hero.line1}<span class="stop" data-wire-start>.</span></span>
    <span class="l2"><em><span class="b" data-wire-end>B</span>uild the fix.</em></span>
  </h1>

  <div class="bottom">
    <div class="lead-block">
      <p class="lead">{hero.lead}</p>
      <div class="cta">
        <a class="btn" href={hero.primary.href} data-magnetic>{hero.primary.label}</a>
        <a class="link" href={hero.secondary.href}>{hero.secondary.label}</a>
      </div>
    </div>
    <ul class="facts">
      {hero.facts.map((f) => (
        <li><b>{f.title}</b><span>{f.text}</span></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hero {
    position: sticky;
    top: 0;
    z-index: 0;
    height: max(100svh, 540px);
    overflow: hidden;
    isolation: isolate;
    background: #e8e8e0;
  }
  .poster,
  .poster img,
  .wall,
  .blur {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .poster,
  .wall {
    opacity: 0.16;
  }
  .poster {
    z-index: -5;
  }
  .wall {
    z-index: -4;
    opacity: 0;
  }
  .wall.ready {
    opacity: 0.16;
  }
  /* Pre-blurred wall: its opacity rises as the page slides over the hero. */
  .blur {
    z-index: -3;
    opacity: 0;
  }
  /* A soft cream veil keeps the wall a quiet presence under the type */
  .veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(ellipse at 40% 45%, rgb(240 235 227 / 0.55), rgb(240 235 227 / 0) 70%);
  }

  /* Headlines: heavy green Fraunces, placed as in the mockup (percentages of the hero) */
  .big {
    position: absolute;
    inset: 0;
    z-index: 4;
    margin: 0;
    font-weight: 560;
    letter-spacing: -0.05em;
    line-height: 0.88;
    font-size: clamp(56px, min(11.95vw, 19.1vh), 232px);
    color: var(--green);
  }
  .big > span {
    position: absolute;
    white-space: nowrap;
  }
  .l1 {
    left: calc(var(--pad) - 8px);
    top: 16%;
  }
  .l2 {
    right: var(--pad);
    top: 56%;
  }
  .l2 em {
    font-family: 'Fraunces Slant', var(--font-display);
    font-style: normal;
    font-weight: 480;
    display: inline-block;
    transform: skewX(-9.5deg);
    transform-origin: 50% 80%;
  }
  .bottom {
    position: absolute;
    left: var(--pad);
    right: var(--pad);
    bottom: clamp(24px, 4.4vh, 40px);
    z-index: 4;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--s-6);
    max-width: calc(var(--max) - var(--pad) * 2);
    margin-inline: auto;
  }
  .lead {
    font-size: var(--fs-lead);
    line-height: 1.5;
    max-width: 34ch;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-4);
    margin-top: var(--s-3);
  }
  .facts {
    display: flex;
    gap: var(--s-6);
  }
  .facts li {
    display: flex;
    flex-direction: column;
    font-size: var(--fs-meta);
    font-weight: 500;
  }
  .facts b {
    font-family: var(--font-display);
    font-weight: 560;
    font-size: var(--fs-fact);
    letter-spacing: -0.02em;
  }

  /* Phones: the headline flows normally; "Find the problem." left, "Build the fix." right */
  @media (max-width: 899px) {
    .hero {
      height: auto;
      min-height: 100svh;
      display: flex;
      flex-direction: column;
      padding: var(--s-16) var(--pad) var(--s-3);
    }
    .big {
      position: static;
      flex: none;
      display: flex;
      flex-direction: column;
      font-size: clamp(44px, 13.5vw, 96px);
      text-wrap: balance;
      margin-bottom: var(--s-4);
    }
    .big > span {
      position: static;
      white-space: normal;
    }
    .l1 {
      align-self: flex-start;
      margin-bottom: clamp(136px, 28svh, 288px);
    }
    .l2 {
      align-self: flex-end;
    }
    .bottom {
      position: static;
      flex-direction: column;
      align-items: stretch;
      gap: var(--s-3);
      margin-top: auto;
      padding-top: var(--s-4);
    }
    .lead {
      font-size: 18px;
    }
    .cta {
      margin-top: var(--s-2);
    }
    .facts {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--s-3);
    }
    .facts li {
      font-size: var(--fs-label);
      line-height: 1.35;
    }
    .facts b {
      font-size: 17px;
      line-height: 1.2;
      margin-bottom: 4px;
    }
  }

  /* Load sequence (1.6s base, every duration and delay x --k). Plays once per session.
     Pure CSS, so nothing can stay hidden if a script fails. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js:not(.seen)) .l1 {
      animation: rise calc(0.55s * var(--k)) var(--ease) both;
    }
    :global(html.js:not(.seen)) .l2 {
      animation: rise calc(0.45s * var(--k)) var(--ease) calc(1.15s * var(--k)) both;
    }
    :global(html.js:not(.seen)) .bottom {
      animation: fade-up calc(0.4s * var(--k)) var(--ease) calc(1.2s * var(--k)) both;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
</style>

<script>
  import '../scripts/hero-wire';

  const hero = document.querySelector<HTMLElement>('.hero');
  const v = document.querySelector<HTMLVideoElement>('.hero .wall');
  const blur = document.querySelector<HTMLElement>('.hero .blur');
  const wire = document.querySelector<SVGElement>('.hero .wire');
  const faint = document.querySelector<HTMLVideoElement>('.wallfaint');
  const content = document.querySelectorAll<HTMLElement>('.hero .big, .hero .bottom');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const conn = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
  const posterOnly = reduced || !!conn?.saveData || /^(slow-2g|2g|3g)$/.test(conn?.effectiveType ?? '');

  let tabVisible = true;
  const sync = () => {
    if (!v || reduced) return;
    const covered = scrollY > innerHeight * 1.1;
    if (tabVisible && !document.hidden && !covered) v.play().catch(() => {});
    else v.pause();
  };

  // The hero stays pinned; the page slides over it. The wall, the line and the pills soften and fade together,
  // scrubbed to scroll and reversible. Only opacity and transform change; the blur is a pre-blurred image
  // fading in (the SVG layer takes one small blur), never a per-frame filter on many elements.
  let ticking = false;
  const onScroll = () => {
    ticking = false;
    if (!hero) return;
    const p = Math.min(1, Math.max(0, scrollY / (innerHeight * 0.9)));
    const lp = Math.min(1, Math.max(0, scrollY / (hero.offsetHeight * 0.6)));
    if (blur) blur.style.opacity = String(p);
    content.forEach((c) => {
      c.style.opacity = String(Math.max(0, 1 - p * 2.4));
    });
    if (wire) {
      wire.style.opacity = String(1 - lp);
      wire.style.filter = lp > 0.02 ? `blur(${(lp * 6).toFixed(2)}px)` : '';
    }
    // the faint wall behind the cream sections fades in as they cover the hero
    if (faint) {
      const fo = 0.16 * Math.min(1, Math.max(0, (scrollY - innerHeight * 0.35) / (innerHeight * 0.5)));
      faint.style.opacity = fo.toFixed(3);
      if (fo > 0 && !posterOnly && matchMedia('(min-width: 900px)').matches) {
        if (!faint.dataset.ready) {
          faint.dataset.ready = '1';
          for (const [type, ext] of [['video/webm', 'webm'], ['video/mp4', 'mp4']] as const) {
            const s = document.createElement('source');
            s.src = `/video/wall-light.${ext}`;
            s.type = type;
            faint.append(s);
          }
          faint.load();
        }
        faint.play().catch(() => {});
      } else if (fo === 0) faint.pause();
    }
    sync();
  };
  addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(onScroll);
      }
    },
    { passive: true },
  );

  if (v && !posterOnly) {
    // phones get the 720p cut (under 1 MB); everything else the full-size one
    const small = matchMedia('(max-width: 899px)').matches;
    for (const [type, ext] of [['video/webm', 'webm'], ['video/mp4', 'mp4']] as const) {
      const src = document.createElement('source');
      src.src = `/video/wall-light${small ? '-720' : ''}.${ext}`;
      src.type = type;
      v.append(src);
    }
    v.addEventListener('playing', () => v.classList.add('ready'), { once: true });
    new IntersectionObserver(([e]) => {
      tabVisible = !!e?.isIntersecting;
      sync();
    }).observe(v);
    document.addEventListener('visibilitychange', sync);
    v.load();
    sync();
  }
  onScroll();
</script>
