---
import HeroVisual from './hero/HeroVisual';
import GlassButton from './GlassButton';
import { withBase } from '../lib/base';

const socials = [
  { label: 'GitHub', href: 'https://github.com/Rydny1' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/rydny-ihims' },
  { label: 'Email', href: 'mailto:rydny01@gmail.com' },
];

// Breathing ambient background — stroke-only rectangles, 9 pewter + 2
// brushed, each on its own non-synced timer (negative delays). A second,
// independent timer sweeps a bright light segment around each shape's
// own perimeter — different shapes light up at different, uncoordinated
// moments so it never reads as one synchronized effect.
const bgShapes = [
  { top: '10%', left: '6%', w: 96, h: 96, color: 'pewter', op: 0.12, dur: 16, delay: -2, lightDur: 9, lightDelay: -1 },
  { top: '68%', left: '10%', w: 160, h: 100, color: 'pewter', op: 0.1, dur: 19, delay: -9, lightDur: 12, lightDelay: -6 },
  { top: '22%', left: '30%', w: 64, h: 64, color: 'pewter', op: 0.15, dur: 14, delay: -4, lightDur: 7, lightDelay: -3 },
  { top: '78%', left: '38%', w: 220, h: 130, color: 'pewter', op: 0.09, dur: 21, delay: -12, lightDur: 15, lightDelay: -11 },
  { top: '4%', left: '52%', w: 120, h: 76, color: 'brushed', op: 0.16, dur: 18, delay: -6, lightDur: 10, lightDelay: -8 },
  { top: '46%', left: '4%', w: 72, h: 72, color: 'pewter', op: 0.13, dur: 15, delay: -1, lightDur: 8, lightDelay: -5 },
  { top: '85%', left: '68%', w: 100, h: 100, color: 'pewter', op: 0.12, dur: 17, delay: -8, lightDur: 11, lightDelay: -2 },
  { top: '14%', left: '80%', w: 280, h: 160, color: 'pewter', op: 0.08, dur: 22, delay: -15, lightDur: 17, lightDelay: -13 },
  { top: '58%', left: '85%', w: 68, h: 68, color: 'brushed', op: 0.14, dur: 16.5, delay: -3, lightDur: 9.5, lightDelay: -7 },
  { top: '32%', left: '62%', w: 140, h: 90, color: 'pewter', op: 0.1, dur: 20, delay: -18, lightDur: 13, lightDelay: -4 },
  { top: '2%', left: '22%', w: 84, h: 130, color: 'pewter', op: 0.13, dur: 15.5, delay: -10, lightDur: 10.5, lightDelay: -9 },
];
---

<section class="hero theme-dark" id="home">
  <div class="hero__ambient" aria-hidden="true">
    {
      bgShapes.map((s) => (
        <div
          class={`bg-shape bg-shape--${s.color}`}
          style={`top:${s.top}; left:${s.left}; width:${s.w}px; height:${s.h}px; --op:${s.op}; --dur:${s.dur}s; --delay:${s.delay}s; --light-dur:${s.lightDur}s; --light-delay:${s.lightDelay}s;`}
        />
      ))
    }
  </div>
  <div class="hero__vignette" aria-hidden="true"></div>

  <div class="container hero__inner">
    <div class="hero__content">
      <p class="hero__badge load-reveal" style="--delay: 0ms">AVAILABLE FOR WORK — RIGA / REMOTE</p>

      <h1 class="hero__name">
        <span class="load-reveal-mask" style="--delay: 60ms"><span class="load-reveal-text">Rydny Ihims</span></span>
      </h1>

      <p class="hero__role">
        <span class="load-reveal-mask" style="--delay: 200ms"
          ><span class="load-reveal-text">I build full-stack web products.</span></span
        >
      </p>

      <p class="hero__bio load-reveal" style="--delay: 320ms">
        Based in Riga. Previously building client projects in Dubai. Clean, functional products —
        from e-commerce platforms to AI-driven analysis tools.
      </p>

      <div class="hero__cta load-reveal" style="--delay: 400ms">
        <GlassButton href={withBase('/projects')} client:visible>View My Work</GlassButton>
        <a href={withBase('/assets/Rydny_Ihims_CV.pdf')} download class="btn btn--ghost">Download CV</a>
      </div>

      <div class="hero__socials load-reveal" style="--delay: 460ms">
        {
          socials.map((s) => (
            <a
              href={s.href}
              class="hero__social"
              target={s.href.startsWith('http') ? '_blank' : undefined}
              rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              aria-label={s.label}>
              {s.label}
            </a>
          ))
        }
      </div>
    </div>

    <div class="hero__visual load-reveal" style="--delay: 260ms">
      <HeroVisual client:visible />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-top: var(--nav-h);
    overflow: hidden;
    background: var(--bg);
    color: var(--text);
  }

  .hero__ambient {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  @property --angle {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }

  .bg-shape {
    position: absolute;
    border: 1px solid var(--pewter);
    opacity: var(--op);
    animation: bg-breathe var(--dur) ease-in-out var(--delay) infinite alternate;
    will-change: opacity, transform;
  }

  .bg-shape--brushed {
    border-color: var(--brushed);
  }

  /* A bright segment travels once around this shape's own perimeter,
     independently timed per shape — light passing through the line,
     not a synchronized sweep across all of them. */
  .bg-shape::before {
    content: '';
    position: absolute;
    inset: -1px;
    --angle: 0deg;
    padding: 1px;
    background: conic-gradient(from var(--angle), transparent 0deg, var(--porcelain) 6deg, transparent 22deg);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0.85;
    animation: light-travel var(--light-dur) linear var(--light-delay) infinite;
  }

  .bg-shape--brushed::before {
    background: conic-gradient(from var(--angle), transparent 0deg, var(--brushed) 6deg, transparent 22deg);
  }

  @keyframes bg-breathe {
    from {
      opacity: calc(var(--op) * 0.35);
      transform: scale(1);
    }
    to {
      opacity: var(--op);
      transform: scale(1.035);
    }
  }

  @keyframes light-travel {
    to {
      --angle: 360deg;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bg-shape {
      animation: none;
      opacity: calc(var(--op) * 0.7);
    }

    .bg-shape::before {
      animation: none;
      opacity: 0;
    }
  }

  .hero__vignette {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(120% 80% at 30% 40%, var(--graphite) 0%, rgba(27, 29, 31, 0) 70%);
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr;
    gap: 56px;
    align-items: center;
    padding-block: 64px;
  }

  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 40px;
    }
  }

  .hero__badge {
    display: inline-block;
    font-size: var(--fs-12);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin-bottom: 24px;
  }

  .hero__name {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 5.5vw + 1rem, var(--fs-76));
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: 20px;
  }

  .hero__role {
    font-size: clamp(var(--fs-18), 2vw + 0.5rem, var(--fs-28));
    font-weight: 300;
    color: var(--text-secondary);
    margin-bottom: 28px;
  }

  .hero__bio {
    font-size: var(--fs-16);
    color: var(--text-secondary);
    max-width: 46ch;
    line-height: 1.75;
    margin-bottom: 40px;
  }

  .hero__cta {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }

  .hero__socials {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .hero__social {
    font-size: var(--fs-14);
    color: var(--text-secondary);
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }

  .hero__social:hover {
    color: var(--text);
    border-color: var(--accent-ui);
  }

  .hero__visual {
    order: -1;
  }

  @media (min-width: 900px) {
    .hero__visual {
      order: 0;
    }
  }

  /* ============================================================
     ONE-TIME LOAD REVEAL — "instrument settle". Plays once on
     first paint only; nothing here ever loops.
  ============================================================ */
  .load-reveal {
    opacity: 0;
    transform: translateY(14px);
    animation: reveal-fade 800ms var(--ease) forwards;
    animation-delay: var(--delay, 0ms);
  }

  .load-reveal-mask {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
  }

  .load-reveal-text {
    display: inline-block;
    clip-path: inset(0 100% 0 0);
    animation: reveal-wipe 800ms var(--ease) forwards;
    animation-delay: var(--delay, 0ms);
  }

  @keyframes reveal-fade {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes reveal-wipe {
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .load-reveal,
    .load-reveal-text {
      animation: none;
      opacity: 1;
      transform: none;
      clip-path: inset(0 0 0 0);
    }
  }
</style>
