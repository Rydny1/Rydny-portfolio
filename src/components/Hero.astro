---
import '../styles/wire.css';
import { copy } from '../content/copy';
import Nav from './Nav.astro';
const { hero } = copy;
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <picture class="poster">
    <source type="image/avif" srcset="/img/wall-poster-800.avif 800w, /img/wall-poster.avif 1600w" sizes="100vw" />
    <source type="image/webp" srcset="/img/wall-poster-800.webp 800w, /img/wall-poster.webp 1600w" sizes="100vw" />
    <img src="/img/wall-poster.jpg" alt="" width="1600" height="900" fetchpriority="high" decoding="async" />
  </picture>
  <video class="wall" muted loop playsinline preload="none" aria-hidden="true" tabindex="-1" poster="/img/wall-poster.jpg">
    <source src="/video/wall-light.webm" type="video/webm" />
    <source src="/video/wall-light.mp4" type="video/mp4" />
  </video>
  <div class="veil" aria-hidden="true"></div>

  <svg class="wire" aria-hidden="true" focusable="false" data-steps={JSON.stringify(hero.steps)}>
    <defs>
      <linearGradient id="capsule" x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-opacity="0"></stop>
        <stop offset="0.5" stop-opacity="1"></stop>
        <stop offset="1" stop-opacity="0"></stop>
      </linearGradient>
      <filter id="soft" x="-50%" y="-200%" width="200%" height="500%"><feGaussianBlur stdDeviation="2.5"></feGaussianBlur></filter>
    </defs>
    <path class="track" pathLength="1"></path>
    <path class="line" pathLength="1"></path>
    <g class="pills"></g>
    <g class="start"></g>
    <g class="end"></g>
    <g class="lights"></g>
  </svg>

  <Nav />

  <div class="inner">
    <h1 id="hero-title">
      <span class="l1">{hero.line1}<span class="stop" data-wire-start>.</span></span>
      <span class="l2"><em><span class="b" data-wire-end>B</span>uild the fix.</em></span>
    </h1>

    <div class="bottom">
      <div class="lead-block">
        <p class="lead">{hero.lead}</p>
        <div class="cta">
          <a class="btn" href={hero.primary.href} data-magnetic>{hero.primary.label}</a>
          <a class="link" href={hero.secondary.href}>{hero.secondary.label}</a>
        </div>
      </div>
      <ul class="facts">
        {hero.facts.map((f) => (
          <li><b>{f.title}</b><span>{f.text}</span></li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    isolation: isolate;
    background: var(--paper);
  }
  .poster,
  .poster img,
  .wall {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .poster {
    z-index: -3;
  }
  .wall {
    z-index: -2;
    opacity: 0;
  }
  .wall.ready {
    opacity: 1;
  }
  .veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgb(246 241 234 / 0.5), rgb(246 241 234 / 0.2) 60%, transparent 80%);
  }
  .inner {
    position: relative;
    z-index: 2;
    min-height: 100svh;
    max-width: var(--max);
    margin-inline: auto;
    padding: clamp(120px, 17vh, 160px) var(--pad) var(--s-6);
    display: flex;
    flex-direction: column;
  }
  h1 {
    font-size: var(--fs-hero);
    font-weight: 380;
    letter-spacing: -0.045em;
    line-height: 0.95;
    display: flex;
    flex-direction: column;
    flex: 1;
    text-wrap: nowrap;
  }
  .l1 {
    align-self: flex-start;
  }
  .l2 {
    align-self: flex-end;
    margin-top: auto;
    margin-bottom: clamp(var(--s-6), 17vh, 160px);
  }
  .l2 em {
    font-style: italic;
    font-weight: 340;
  }
  .bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--s-6);
    margin-top: var(--s-3);
  }
  .lead {
    font-size: var(--fs-lead);
    line-height: 1.5;
    max-width: 34ch;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-4);
    margin-top: var(--s-3);
  }
  .facts {
    display: flex;
    gap: var(--s-6);
  }
  .facts li {
    display: flex;
    flex-direction: column;
    font-size: var(--fs-meta);
    font-weight: 500;
  }
  .facts b {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--fs-fact);
    letter-spacing: -0.01em;
  }

  /* Desktop: the hero is exactly one screen. Type scales with the smaller of width and height. */
  @media (min-width: 900px) {
    .hero {
      height: max(100svh, 620px);
      min-height: 0;
    }
    .inner {
      height: 100%;
      min-height: 0;
      padding-bottom: clamp(var(--s-3), 5vh, var(--s-6));
    }
    h1 {
      font-size: clamp(52px, min(7.4vw, 13vh), 128px);
    }
  }

  @media (max-width: 899px) {
    h1 {
      font-size: clamp(44px, 13.5vw, 96px);
      text-wrap: balance;
    }
    .l1,
    .l2 {
      align-self: flex-start;
    }
    .l1 {
      margin-bottom: var(--s-8);
    }
    .l2 {
      margin-bottom: 0;
    }
    .inner {
      padding-top: var(--s-16);
      padding-bottom: var(--s-3);
    }
    .bottom {
      flex-direction: column;
      align-items: stretch;
      gap: var(--s-3);
      margin-top: var(--s-4);
    }
    .lead {
      font-size: 18px;
    }
    .cta {
      margin-top: var(--s-2);
    }
    .facts {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--s-2);
    }
    .facts li {
      font-size: var(--fs-label);
      line-height: 1.35;
    }
    .facts b {
      font-size: 17px;
      line-height: 1.2;
      margin-bottom: 4px;
    }
  }

  /* Load sequence (1.6s base, every duration and delay x --k). Plays once per session.
     Pure CSS, so nothing can stay hidden if a script fails. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js:not(.seen)) .l1 {
      animation: rise calc(0.55s * var(--k)) var(--ease) both;
    }
    :global(html.js:not(.seen)) .l2 {
      animation: rise calc(0.45s * var(--k)) var(--ease) calc(1.15s * var(--k)) both;
    }
    :global(html.js:not(.seen)) .lead-block,
    :global(html.js:not(.seen)) .facts {
      animation: fade-up calc(0.4s * var(--k)) var(--ease) calc(1.2s * var(--k)) both;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
</style>

<script>
  import '../scripts/hero-wire';

  // Play the wall only when on screen and the tab is visible. Reduced motion: poster only.
  const v = document.querySelector<HTMLVideoElement>('.hero .wall');
  if (v && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let visible = true;
    const sync = () => {
      if (visible && !document.hidden) v.play().catch(() => {});
      else v.pause();
    };
    v.addEventListener('playing', () => v.classList.add('ready'), { once: true });
    new IntersectionObserver(([e]) => {
      visible = !!e?.isIntersecting;
      sync();
    }).observe(v);
    document.addEventListener('visibilitychange', sync);
    v.load();
    sync();
  }
</script>
