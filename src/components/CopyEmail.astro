---
import { copy } from '../content/copy';
const email = copy.contact.email;
---

<span class="cm" data-copy-email>
  <button class="cm-btn" type="button" aria-label={`Copy email address ${email}`}>
    <span class="cm-text">{email}</span>
    <svg class="cm-ico cm-copy" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V6a2 2 0 0 1 2-2h9"></path></svg>
    <svg class="cm-ico cm-check" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
  </button>
  <span class="cm-note" aria-hidden="true">Copied</span>
  <a class="cm-open" href={`mailto:${email}`}>or open in email app</a>
  <span class="sr-only" role="status" aria-live="polite" data-live></span>
</span>

<style is:global>
  .cm {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
  }
  .cm-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 48px;
    padding: 0 16px;
    border: 1px solid currentColor;
    border-color: color-mix(in srgb, currentColor 40%, transparent);
    border-radius: 999px;
    background: none;
    color: inherit;
    font: inherit;
    font-size: 16px;
    cursor: pointer;
    user-select: text;
    transition: border-color 0.3s var(--ease), background-color 0.3s var(--ease);
  }
  .cm-btn:hover {
    border-color: currentColor;
  }
  .cm-ico {
    flex: none;
  }
  .cm-check {
    display: none;
  }
  .cm.copied .cm-copy {
    display: none;
  }
  .cm.copied .cm-check {
    display: block;
    color: var(--signal);
  }
  .cm-note {
    font-size: 13px;
    letter-spacing: 0.06em;
    opacity: 0;
    transition: opacity 0.4s var(--ease);
  }
  .cm.copied .cm-note {
    opacity: 0.85;
  }
  .cm-open {
    flex-basis: 100%;
    font-size: 13px;
    opacity: 0.7;
    text-decoration: none;
  }
  .cm-open:hover,
  .cm-open:focus-visible {
    text-decoration: underline;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-copy-email]').forEach((box) => {
    const btn = box.querySelector<HTMLButtonElement>('.cm-btn')!;
    const live = box.querySelector<HTMLElement>('[data-live]')!;
    let timer = 0;
    const done = (msg: string, announce: string) => {
      box.querySelector<HTMLElement>('.cm-note')!.textContent = msg;
      live.textContent = '';
      requestAnimationFrame(() => (live.textContent = announce));
      box.classList.add('copied');
      clearTimeout(timer);
      timer = window.setTimeout(() => box.classList.remove('copied'), 1500);
    };
    const select = () => {
      const r = document.createRange();
      r.selectNodeContents(btn.querySelector('.cm-text')!);
      const s = getSelection();
      s?.removeAllRanges();
      s?.addRange(r);
    };
    btn.addEventListener('click', async () => {
      const text = btn.querySelector('.cm-text')!.textContent!.trim();
      try {
        await navigator.clipboard.writeText(text);
        done('Copied', 'Email copied');
      } catch {
        select();
        let ok = false;
        try {
          ok = document.execCommand('copy');
        } catch {
          ok = false;
        }
        done(ok ? 'Copied' : 'Press Ctrl+C', ok ? 'Email copied' : 'Email selected. Press Control C to copy.');
      }
    });
  });
</script>
