---
import { copy } from '../content/copy';
const { contact: c } = copy;
---

<section class="contact" id="contact" aria-labelledby="contact-title" data-node>
  <!-- Cream to night: a smooth ramp, never a hard edge -->
  <div class="fade" aria-hidden="true"></div>
  <!-- Leaf shadows keep drifting, very faintly, on the night background (desktop, in view only) -->
  <video class="shadows" muted loop playsinline preload="none" aria-hidden="true" tabindex="-1" poster="/img/wall-blur.webp" data-webm="/video/wall-light.webm" data-mp4="/video/wall-light.mp4"></video>

  <div class="wrap" data-tone="dark">
    <div class="ctop">
      <h2 id="contact-title" data-title>Get in<br />touch<span class="fs">.</span></h2>
      <div class="leadcol">
        <p class="lead" data-words>{c.lead}</p>
        <p class="avail">{c.availability}</p>
      </div>
    </div>

    <div class="letter-wrap" data-form-wrap data-reveal data-delay="120">
      <form class="letter" action="/api/contact" method="post" novalidate data-contact-form>
        <p class="line">
          {c.form.hi}{' '}
          <span class="blank"><label class="sr-only" for="f-name">{c.form.nameLabel}</label><input id="f-name" name="name" type="text" required maxlength="80" autocomplete="name" placeholder={c.form.namePh} /></span>{' '}
          {c.form.from}{' '}
          <span class="blank"><label class="sr-only" for="f-company">{c.form.companyLabel}</label><input id="f-company" name="company" type="text" maxlength="80" autocomplete="organization" placeholder={c.form.companyPh} /></span>.
        </p>

        <fieldset class="line choice">
          <legend>{c.form.like}</legend>
          <div class="pills">
            {c.form.choices.map((ch, i) => (
              <label class="pill">
                <input type="radio" name="choice" value={ch} required={i === 0} />
                <span>{ch}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <p class="line">
          <label for="f-message">{c.form.short}</label>{' '}
          <textarea id="f-message" name="message" rows="1" required minlength="5" maxlength="600" placeholder={c.form.messagePh}></textarea>
        </p>

        <p class="line">
          {c.form.reach}{' '}
          <span class="blank"><label class="sr-only" for="f-email">{c.form.emailLabel}</label><input id="f-email" name="email" type="email" required maxlength="120" autocomplete="email" placeholder={c.form.emailPh} /></span>.
        </p>

        <div class="hp" aria-hidden="true">
          <label>Leave this empty<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>
        <input type="hidden" name="t" value="" />

        <div class="actions">
          <button class="btn" type="submit" data-magnetic>{c.form.submit}</button>
          <p class="prefer">{c.form.prefer} <a class="mail" href={`mailto:${c.email}`}>{c.email}</a></p>
          <p class="err" role="alert" data-error></p>
        </div>
      </form>

      <div class="sent" role="status" tabindex="-1" hidden data-sent>
        <p>{c.form.sent}</p>
      </div>
    </div>

    <div class="footrow" data-end-node>
      <ul class="small">
        {c.links.map((l) => (
          <li><a class="flink" href={l.href} rel="noopener">{l.label}</a></li>
        ))}
        {c.cv && <li><a class="flink" href={c.cv} download>{c.cvLabel}</a></li>}
        <li class="clock">Riga, <time data-riga-time datetime=""></time> <span data-riga-zone>GMT+2</span></li>
      </ul>
      <p class="status"><span class="live" aria-hidden="true"></span>{c.status}</p>
    </div>

    <div class="big" aria-hidden="true" data-letters>{[...'Rydny Ihims'].map((ch) => <span class="ch">{ch === ' ' ? ' ' : ch}</span>)}</div>
    <footer>{c.footer}</footer>
  </div>
</section>

<style>
  .contact {
    position: relative;
    isolation: isolate;
    padding: 0 0 56px;
    background: var(--night);
    color: var(--paper);
  }
  .fade {
    height: 220px;
    background: linear-gradient(to bottom, var(--paper), var(--night));
  }
  .shadows {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.07;
    mix-blend-mode: screen;
    pointer-events: none;
  }
  .contact :global(:focus-visible) {
    outline-color: var(--paper);
  }

  .ctop {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: end;
    padding-top: 96px;
  }
  h2 {
    font-size: clamp(64px, 11.7vw, 168px);
    line-height: 0.84;
    font-weight: 560;
    letter-spacing: -0.05em;
  }
  .leadcol {
    padding-bottom: 18px;
  }
  .lead {
    font-size: 20px;
    max-width: 36ch;
    opacity: 0.8;
  }
  .avail {
    margin-top: var(--s-2);
    font-size: 14px;
    max-width: 36ch;
    text-wrap: balance;
    opacity: 0.6;
  }

  .letter-wrap {
    position: relative;
    margin-top: 80px;
    padding-top: 56px;
    border-top: 1px solid rgb(238 233 227 / 0.14);
  }
  .letter {
    font-family: var(--font-display);
    font-size: clamp(24px, 2.78vw, 40px);
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: -0.015em;
  }
  .line {
    max-width: none;
  }
  .letter label:not(.sr-only):not(.pill) {
    font: inherit;
  }

  /* Inline underlined blanks that grow as you type */
  .blank {
    display: inline-block;
    max-width: 100%;
    vertical-align: baseline;
  }
  .letter input[type='text'],
  .letter input[type='email'],
  .letter textarea {
    font: inherit;
    letter-spacing: inherit;
    color: var(--paper);
    background: linear-gradient(var(--signal), var(--signal)) left bottom / 0 2px no-repeat;
    border: 0;
    border-bottom: 1.5px solid rgb(238 233 227 / 0.3);
    border-radius: 0;
    padding: 0 4px;
    margin: 0;
    outline: none;
    field-sizing: content;
    min-width: 240px;
    max-width: 100%;
    transition: background-size 0.4s var(--ease);
  }
  .letter textarea {
    display: inline-block;
    vertical-align: baseline;
    min-width: min(440px, 100%);
    resize: none;
    line-height: 1.3;
    height: auto;
    overflow: hidden;
  }
  .letter input:focus,
  .letter textarea:focus {
    background-size: 100% 2px;
  }
  .letter ::placeholder {
    color: rgb(238 233 227 / 0.38);
    font-style: italic;
    opacity: 1;
  }
  .letter [aria-invalid='true'] {
    border-bottom-color: var(--paper);
    border-bottom-style: dashed;
  }

  .choice {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }
  .choice legend {
    padding: 0;
    float: left;
    margin-right: var(--s-1);
  }
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    overflow: hidden;
    padding-block: 4px;
    align-items: center;
    min-height: 1.6em;
  }
  .pill {
    position: relative;
    cursor: pointer;
  }
  .pill input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .pill span {
    display: flex;
    align-items: center;
    min-height: 40px;
    padding: 0 16px;
    font: 600 15px/1.2 var(--font-body);
    letter-spacing: 0;
    border: 1px solid rgb(238 233 227 / 0.3);
    border-radius: var(--radius-pill);
    transition: background-color 0.25s var(--ease), color 0.25s var(--ease);
  }
  .pill:hover span {
    border-color: var(--paper);
  }
  .pill input:checked + span {
    background: var(--paper);
    color: var(--night);
    border-color: var(--paper);
  }
  .pill input:focus-visible + span {
    outline: 2px solid var(--paper);
    outline-offset: 3px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-3);
    margin-top: 44px;
    font-family: var(--font-body);
    font-size: 15px;
  }
  .prefer {
    font: 400 15px/1.4 var(--font-body);
    letter-spacing: 0;
    opacity: 0.6;
  }
  .mail {
    text-decoration: none;
  }
  .err {
    flex-basis: 100%;
    font: 500 15px/1.4 var(--font-body);
    letter-spacing: 0;
    max-width: 40ch;
  }
  .err:empty {
    display: none;
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .sent {
    font-family: var(--font-display);
    font-size: clamp(24px, 2.78vw, 40px);
    line-height: 1.3;
    letter-spacing: -0.02em;
    padding-block: var(--s-6);
  }
  .sent:focus {
    outline: none;
  }

  /* Footer row: links and the Riga time on the left, the live status on the right */
  .footrow {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-3);
    margin-top: 150px;
    padding-top: 32px;
    border-top: 1px solid rgb(238 233 227 / 0.14);
    font-size: 14px;
  }
  .small {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-1) 28px;
    opacity: 0.75;
  }
  .flink {
    color: inherit;
    text-decoration: none;
  }
  .clock {
    font-variant-numeric: tabular-nums;
  }
  .status {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.8;
  }
  .live {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 0 6px rgb(228 87 46 / 0.18);
  }

  .big {
    overflow: hidden;
    padding-bottom: var(--s-4);
    padding-right: 0.16em; /* room for the last letter's overhang */
    font-family: var(--font-display);
    font-size: min(14.7vw, calc((100vw - 2 * var(--pad)) / 6.4), 228px);
    font-weight: 560;
    letter-spacing: -0.055em;
    line-height: 0.78;
    color: #e9e3d8;
    margin-top: 40px;
    white-space: nowrap;
  }
  .big :global(.ch) {
    display: inline-block;
    white-space: pre;
  }
  footer {
    margin-top: var(--s-3);
    font-size: var(--fs-meta);
    opacity: 0.6;
  }

  @media (max-width: 899px) {
    .fade {
      height: 120px;
    }
    .ctop {
      grid-template-columns: 1fr;
      gap: var(--s-3);
      padding-top: var(--s-6);
    }
    .leadcol {
      padding-bottom: 0;
    }
    .letter-wrap {
      margin-top: var(--s-6);
      padding-top: var(--s-4);
    }
    .letter input[type='text'],
    .letter input[type='email'],
    .letter textarea {
      min-width: 9ch;
    }
    .letter textarea {
      display: block;
      width: 100%;
      min-width: 0;
      margin-top: var(--s-1);
    }
    .shadows {
      display: none;
    }
    .footrow {
      flex-direction: column;
      align-items: flex-start;
      margin-top: var(--s-8);
    }
    .big {
      margin-top: var(--s-2);
    }
  }
</style>
