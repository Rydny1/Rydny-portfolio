---
import { copy } from '../content/copy';
const { contact: c } = copy;
---

<section class="contact" id="contact" aria-labelledby="contact-title" data-node>
  <div class="wrap">
    <h2 id="contact-title">{c.title}</h2>
    <p class="lead">{c.lead}</p>
    <a class="email" href={`mailto:${c.email}`}>{c.email}</a>
    <ul class="small">
      {c.links.map((l) => (
        <li><a class="link" href={l.href} rel="noopener">{l.label}</a></li>
      ))}
      {c.cv && <li><a class="link" href={c.cv} download>{c.cvLabel}</a></li>}
    </ul>

    <div class="big" aria-hidden="true">Rydny Ihims</div>
    <p class="status label"><span class="dot"></span>{c.status}</p>
    <footer>{c.footer}</footer>
  </div>
</section>

<style>
  .contact {
    padding-block: var(--section-y) var(--s-6);
    background: var(--paper);
  }
  h2 {
    font-size: clamp(48px, 8vw, 128px);
    line-height: 0.92;
    margin-bottom: var(--s-6);
    max-width: 14ch;
  }
  .lead {
    font-size: var(--fs-lead);
    margin-bottom: var(--s-6);
  }
  .email {
    display: inline-block;
    font-family: var(--font-display);
    font-size: clamp(28px, 5vw, 72px);
    letter-spacing: -0.02em;
    text-decoration: none;
    background: linear-gradient(var(--signal), var(--signal)) left bottom / 0 3px no-repeat;
    border-bottom: 1px solid var(--ink);
    transition: background-size 0.35s var(--ease);
    overflow-wrap: anywhere;
  }
  .email:hover {
    background-size: 100% 3px;
  }
  .small {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    margin-top: var(--s-4);
  }
  .big {
    font-family: var(--font-display);
    font-size: clamp(56px, 15.5vw, 240px);
    font-weight: 380;
    letter-spacing: -0.045em;
    line-height: 0.9;
    margin-top: var(--s-16);
    white-space: nowrap;
  }
  .status {
    display: flex;
    align-items: center;
    gap: var(--s-1);
    margin-top: var(--s-3);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--signal);
  }
  footer {
    margin-top: var(--s-12);
    padding-top: var(--s-3);
    border-top: 1px solid var(--hairline);
    font-size: var(--fs-meta);
    color: var(--mist);
  }
</style>
