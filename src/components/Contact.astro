---
import { copy } from '../content/copy';
const { contact: c } = copy;
---

<section class="contact" id="contact" aria-labelledby="contact-title" data-node>
  <!-- Leaf shadows keep drifting, very faintly, on the night background (desktop, in view only) -->
  <video class="shadows" muted loop playsinline preload="none" aria-hidden="true" tabindex="-1" poster="/img/wall-blur.webp" data-webm="/video/wall-light.webm" data-mp4="/video/wall-light.mp4"></video>

  <div class="wrap">
    <div class="top">
      <h2 id="contact-title" data-title>{c.title}<span class="fs">.</span></h2>
      <p class="lead" data-reveal data-delay="120">{c.lead}</p>
    </div>

    <div class="letter-wrap" data-form-wrap data-reveal data-delay="120">
      <form class="letter" action="/api/contact" method="post" novalidate data-contact-form>
        <p class="line">
          {c.form.hi}{' '}
          <span class="blank"><label class="sr-only" for="f-name">{c.form.nameLabel}</label><input id="f-name" name="name" type="text" required maxlength="80" autocomplete="name" placeholder={c.form.namePh} /></span>{' '}
          {c.form.from}{' '}
          <span class="blank"><label class="sr-only" for="f-company">{c.form.companyLabel}</label><input id="f-company" name="company" type="text" maxlength="80" autocomplete="organization" placeholder={c.form.companyPh} /></span>.
        </p>

        <fieldset class="line choice">
          <legend>{c.form.like}</legend>
          <div class="pills">
            {c.form.choices.map((ch, i) => (
              <label class="pill">
                <input type="radio" name="choice" value={ch} required={i === 0} />
                <span>{ch}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <p class="line">
          <label for="f-message">{c.form.short}</label>
          <textarea id="f-message" name="message" rows="2" required minlength="5" maxlength="600" placeholder={c.form.messagePh}></textarea>
        </p>

        <p class="line">
          {c.form.reach}{' '}
          <span class="blank"><label class="sr-only" for="f-email">{c.form.emailLabel}</label><input id="f-email" name="email" type="email" required maxlength="120" autocomplete="email" placeholder={c.form.emailPh} /></span>.
        </p>

        <div class="hp" aria-hidden="true">
          <label>Leave this empty<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>
        <input type="hidden" name="t" value="" />

        <div class="actions">
          <button class="btn" type="submit" data-magnetic>{c.form.submit}</button>
          <p class="prefer">{c.form.prefer} <a class="link" href={`mailto:${c.email}`}>{c.email}</a></p>
          <p class="err" role="alert" data-error></p>
        </div>
      </form>

      <div class="sent" role="status" tabindex="-1" hidden data-sent>
        <p>{c.form.sent}</p>
      </div>
    </div>

    <div class="footrow" data-end-node>
      <ul class="small">
        {c.links.map((l) => (
          <li><a class="link" href={l.href} rel="noopener">{l.label}</a></li>
        ))}
        {c.cv && <li><a class="link" href={c.cv} download>{c.cvLabel}</a></li>}
        <li class="clock">Riga, <time data-riga-time datetime=""></time> <span data-riga-zone>GMT+2</span></li>
      </ul>
      <p class="status label"><span class="live" aria-hidden="true"></span>{c.status}</p>
    </div>

    <div class="big" aria-hidden="true" data-letters>{[...'Rydny Ihims'].map((ch) => <span class="ch">{ch === ' ' ? ' ' : ch}</span>)}</div>
    <footer>{c.footer}</footer>
  </div>
</section>

<style>
  .contact {
    --letter: clamp(22px, 2.6vw, 36px);
    position: relative;
    isolation: isolate;
    overflow: visible;
    padding-block: var(--section-y) var(--s-4);
    background: var(--night);
    color: var(--paper);
  }
  /* Cream to night: a soft ramp over the padding at the bottom of About, never a hard edge */
  .contact::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: calc(-1 * var(--section-y) - var(--s-8));
    height: calc(var(--section-y) + var(--s-8));
    background: linear-gradient(to bottom, transparent, rgb(23 24 26 / 0.55) 45%, var(--night));
    pointer-events: none;
  }
  .shadows {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.1;
    mix-blend-mode: screen;
    pointer-events: none;
  }
  .contact :global(:focus-visible) {
    outline-color: var(--paper);
  }
  .contact :global(.link) {
    color: var(--paper);
  }

  .top {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: var(--s-6);
    align-items: end;
    padding-bottom: var(--s-6);
    border-bottom: 1px solid rgb(238 233 227 / 0.18);
    margin-bottom: var(--s-6);
  }
  h2 {
    font-size: clamp(56px, 8.4vw, 136px);
    line-height: 0.9;
    max-width: 6ch;
  }
  .lead {
    font-size: var(--fs-lead);
    color: var(--on-night-mist);
    max-width: 34ch;
    margin-bottom: var(--s-1);
  }

  .letter-wrap {
    position: relative;
    max-width: 1040px;
  }
  .letter {
    font-family: var(--font-display);
    font-size: var(--letter);
    font-weight: 380;
    line-height: 1.5;
    letter-spacing: -0.02em;
  }
  .line {
    max-width: none;
    margin-bottom: var(--s-2);
  }
  .letter label:not(.sr-only):not(.pill) {
    font: inherit;
  }

  /* Inline underlined blanks that grow as you type */
  .blank {
    display: inline-block;
    max-width: 100%;
    vertical-align: baseline;
  }
  .letter input[type='text'],
  .letter input[type='email'],
  .letter textarea {
    font: inherit;
    letter-spacing: inherit;
    color: var(--paper);
    background: linear-gradient(var(--signal), var(--signal)) left bottom / 0 2px no-repeat;
    border: 0;
    border-bottom: 1px solid rgb(238 233 227 / 0.4);
    border-radius: 0;
    padding: 0 4px;
    margin: 0;
    outline: none;
    field-sizing: content;
    min-width: 9ch;
    max-width: 100%;
    transition: background-size 0.4s var(--ease);
  }
  .letter textarea {
    display: block;
    width: 100%;
    min-height: 2.9em;
    resize: none;
    margin-top: var(--s-1);
    line-height: 1.45;
  }
  .letter input:focus,
  .letter textarea:focus {
    background-size: 100% 2px;
  }
  .letter ::placeholder {
    color: rgb(238 233 227 / 0.5);
    font-style: italic;
    opacity: 1;
  }
  .letter [aria-invalid='true'] {
    border-bottom-color: var(--paper);
    border-bottom-style: dashed;
  }

  .choice {
    border: 0;
    padding: 0;
    min-width: 0;
  }
  .choice legend {
    padding: 0;
    float: left;
    margin-right: var(--s-2);
  }
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1);
    overflow: hidden;
    padding-block: 4px;
  }
  .pill {
    position: relative;
    cursor: pointer;
  }
  .pill input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .pill span {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--s-2);
    font: 500 16px/1.2 var(--font-body);
    letter-spacing: 0;
    border: 1px solid rgb(238 233 227 / 0.45);
    border-radius: var(--radius-pill);
    transition: background-color 0.25s var(--ease), color 0.25s var(--ease);
  }
  .pill:hover span {
    border-color: var(--paper);
  }
  .pill input:checked + span {
    background: var(--paper);
    color: var(--ink);
    border-color: var(--paper);
  }
  .pill input:focus-visible + span {
    outline: 2px solid var(--paper);
    outline-offset: 3px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-3);
    margin-top: var(--s-3);
  }
  .prefer {
    font: 400 14px/1.4 var(--font-body);
    letter-spacing: 0;
    color: var(--on-night-mist);
  }
  .err {
    flex-basis: 100%;
    font: 500 15px/1.4 var(--font-body);
    letter-spacing: 0;
    color: var(--paper);
    max-width: 40ch;
  }
  .err:empty {
    display: none;
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .sent {
    font-family: var(--font-display);
    font-size: var(--letter);
    line-height: 1.3;
    letter-spacing: -0.02em;
    padding-block: var(--s-6);
  }
  .sent:focus {
    outline: none;
  }

  /* Footer row: links and the Riga time on the left, the live status on the right */
  .footrow {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-3);
    margin-top: var(--s-8);
    padding-top: var(--s-3);
    border-top: 1px solid rgb(238 233 227 / 0.18);
    font-size: 14px;
    color: var(--on-night-mist);
  }
  .small {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-1) var(--s-3);
  }
  .clock {
    font-variant-numeric: tabular-nums;
  }
  .status {
    display: flex;
    align-items: center;
    gap: var(--s-1);
    color: var(--on-night-mist);
  }
  .live {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 0 4px rgb(228 87 46 / 0.2);
  }

  .big {
    overflow: hidden;
    padding-bottom: var(--s-4);
    font-family: var(--font-display);
    font-size: min(14.2vw, 206px);
    font-weight: 380;
    letter-spacing: -0.045em;
    line-height: 0.9;
    margin-top: var(--s-3);
    white-space: nowrap;
  }
  .big :global(.ch) {
    display: inline-block;
    white-space: pre;
  }
  footer {
    margin-top: var(--s-3);
    padding-top: var(--s-3);
    border-top: 1px solid rgb(238 233 227 / 0.18);
    font-size: var(--fs-meta);
    color: var(--on-night-mist);
  }

  @media (max-width: 899px) {
    .top {
      grid-template-columns: 1fr;
      gap: var(--s-3);
      padding-bottom: var(--s-4);
      margin-bottom: var(--s-4);
    }
    .shadows {
      display: none;
    }
    .footrow {
      flex-direction: column;
      align-items: flex-start;
      margin-top: var(--s-6);
    }
  }
</style>

