---
import WorkGrid from './work/WorkGrid';
---

<section class="work section" id="work">
  <div class="hairline-draw" aria-hidden="true"></div>
  <div class="container">
    <div class="section-header reveal">
      <span class="section-label">Selected Work</span>
      <h2 class="section-heading">Work</h2>
    </div>

    <WorkGrid client:visible />
  </div>
</section>

<style>
  .section-header {
    margin-bottom: 56px;
  }
</style>
