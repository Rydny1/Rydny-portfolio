---
import { copy } from '../content/copy';
import Pic from './Pic.astro';
const { about } = copy;
---

<section class="about" id="about" aria-labelledby="about-title" data-node>
  <div class="wrap grid">
    <figure class="portrait" data-reveal>
      <div class="frame" data-parallax data-tone="dark">
        <Pic
          base="portrait-960"
          srcset={[
            { w: 480, base: 'portrait-480' },
            { w: 960, base: 'portrait-960' },
          ]}
          sizes="(min-width: 900px) 40vw, 80vw"
          alt={about.alt}
          width={960}
          height={1200}
        />
      </div>
      <figcaption class="label">{about.caption}</figcaption>
    </figure>

    <div class="text" data-reveal data-delay="120">
      <h2 id="about-title" data-title>{about.title}<span class="fs">.</span></h2>
      {about.paragraphs.map((t) => <p>{t}</p>)}
      <blockquote>
        <p>{about.quote.text}</p>
        <cite>{about.quote.cite}</cite>
      </blockquote>
      <p class="tools">{about.tools.join(' · ')}</p>
    </div>
  </div>
</section>

<style>
  .about {
    padding-block: var(--section-y);
    background: var(--paper-glass);
  }
  .grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: var(--s-8);
    align-items: start;
  }
  .frame {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--ink);
    box-shadow: 0 30px 60px -20px rgb(31 32 35 / 0.45), 0 8px 18px rgb(31 32 35 / 0.18);
  }
  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .frame::after {
    content: '';
    position: absolute;
    inset: -12%;
    background: url('/img/wall-blur.webp') center / cover;
    mix-blend-mode: multiply;
    opacity: 0.5;
    pointer-events: none;
    animation: leaf-drift 26s ease-in-out infinite alternate;
  }
  @keyframes leaf-drift {
    from {
      transform: translate3d(-4%, -2%, 0) scale(1.05);
    }
    to {
      transform: translate3d(4%, 3%, 0) scale(1.15);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .frame::after {
      animation: none;
    }
  }
  figcaption {
    margin-top: var(--s-2);
  }
  h2 {
    font-size: clamp(48px, 6vw, 96px);
    line-height: 0.95;
    margin-bottom: var(--s-6);
  }
  .text p {
    margin-bottom: var(--s-3);
  }
  blockquote {
    margin: var(--s-6) 0;
    padding-left: var(--s-3);
    border-left: 2px solid var(--ink);
  }
  blockquote p {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 22px;
    margin-bottom: var(--s-1);
  }
  cite {
    font-size: var(--fs-meta);
    color: var(--mist);
    font-style: normal;
  }
  .tools {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--mist);
  }
  @media (max-width: 899px) {
    .grid {
      grid-template-columns: 1fr;
      gap: var(--s-6);
    }
    .portrait {
      max-width: 400px;
    }
  }
</style>
