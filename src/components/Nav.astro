---
import { copy } from '../content/copy';
const { nav, contact } = copy;
---

<header class="nav" data-nav>
  <div class="in">
    <div class="bar">
      <a class="name" href="#top">{nav.name}</a>
      <span class="tag">{nav.role}</span>
      <nav aria-label="Primary" class="links">
        <ul>
          {nav.links.map((l) => (
            <li><a class="roll" href={l.href} data-text={l.label}><span>{l.label}</span></a></li>
          ))}
        </ul>
      </nav>
      <a class="touch" href={nav.cta.href}>{nav.cta.label}</a>
      <button class="burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="sheet" data-menu-open>
        <span></span><span></span>
      </button>
    </div>
    <!-- Phones only: tagline stays full size, the time is smaller and quieter -->
    <div class="meta" aria-hidden="true">
      <span>{nav.role}</span>
      <span class="clock">{nav.city} <time data-riga-time datetime=""></time></span>
    </div>
  </div>
</header>

<!-- Phones: bottom-sheet menu -->
<div class="sheet-root" data-sheet-root hidden>
  <div class="backdrop" data-menu-close></div>
  <div class="sheet" id="sheet" role="dialog" aria-modal="true" aria-label="Menu" data-sheet>
    <div class="grab" aria-hidden="true"></div>
    <ul class="sheet-links">
      {nav.links.map((l) => (
        <li><a href={l.href} data-menu-close>{l.label}</a></li>
      ))}
    </ul>
    <div class="sheet-foot">
      <p>{nav.city} <time data-riga-time datetime=""></time></p>
      <a class="link" href={`mailto:${contact.email}`}>{contact.email}</a>
    </div>
    <button class="sheet-close" type="button" data-menu-close>Close</button>
  </div>
</div>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    isolation: isolate;
    font-size: var(--fs-meta);
    font-weight: 500;
    color: var(--ink);
    transition: color 0.35s var(--ease);
  }
  /* Glass behind the logo and links only (z-index -1). Medium tint so the text always reads, and only the last
     fifth of the height fades out, so there is never a visible edge. No border. */
  .nav::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(238 233 227 / 0.46);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 78%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 78%, transparent 100%);
    opacity: 0;
    transition: opacity 0.4s var(--ease), background-color 0.35s var(--ease);
  }
  /* The glass only exists once you scroll out of the hero; the opening view has no bar at all */
  .nav.glass::before {
    opacity: 1;
  }
  /* Over anything dark (the night section, dark screenshots) the text turns paper and the glass darkens */
  .nav.on-dark {
    color: var(--paper);
  }
  .nav.on-dark::before {
    background: rgb(22 22 21 / 0.5);
  }
  .in {
    max-width: var(--max);
    margin-inline: auto;
    padding: 22px var(--pad);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
  }
  .name {
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 560;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  ul {
    display: flex;
    gap: var(--s-4);
  }
  nav a {
    text-decoration: none;
  }
  /* Letters roll up and are replaced by the same word (two stacked copies). */
  .roll {
    position: relative;
    display: inline-block;
    overflow: hidden;
    line-height: 1.5;
  }
  .roll span {
    display: block;
    transition: transform 0.45s var(--ease);
  }
  .roll::after {
    content: attr(data-text);
    position: absolute;
    left: 0;
    top: 100%;
    transition: transform 0.45s var(--ease);
  }
  .roll:hover span,
  .roll:focus-visible span,
  .roll:hover::after,
  .roll:focus-visible::after {
    transform: translateY(-100%);
  }
  .touch {
    display: inline-flex;
    align-items: center;
    min-height: 46px;
    padding: 0 18px;
    border: 1px solid currentColor;
    border-radius: var(--radius-pill);
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
    transition: background-color 0.3s var(--ease), color 0.3s var(--ease);
  }
  .touch:hover {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .on-dark .touch:hover {
    background: var(--paper);
    color: var(--ink);
    border-color: var(--paper);
  }
  .burger,
  .meta {
    display: none;
  }
  .nav.on-dark :global(:focus-visible) {
    outline-color: var(--paper);
  }

  /* Phones */
  @media (max-width: 899px) {
    .nav::before {
      background: rgb(238 233 227 / 0.62);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
    }
    .nav.on-dark::before {
      background: rgb(22 22 21 / 0.62);
    }
    .in {
      padding: var(--s-1) var(--pad) var(--s-2);
    }
    .links,
    .touch,
    .tag {
      display: none;
    }
    .burger {
      display: block;
      width: 44px;
      height: 44px;
      margin-right: -10px;
      padding: 0;
      border: 0;
      background: none;
      color: inherit;
      cursor: pointer;
      position: relative;
    }
    /* Two thin lines, no circle, no box */
    .burger span {
      position: absolute;
      right: 10px;
      height: 1.5px;
      background: currentColor;
    }
    .burger span:first-child {
      top: 18px;
      width: 24px;
    }
    .burger span:last-child {
      top: 25px;
      width: 16px;
    }
    .meta {
      display: flex;
      justify-content: space-between;
      gap: var(--s-3);
      margin-top: 0;
      font-size: var(--fs-meta);
    }
    .clock {
      font-size: 12px;
      opacity: 0.65;
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }
  }

  /* Bottom sheet */
  .sheet-root[hidden] {
    display: none;
  }
  .sheet-root {
    position: fixed;
    inset: 0;
    z-index: 80;
  }
  .backdrop {
    position: absolute;
    inset: 0;
    background: rgb(22 22 21 / 0.45);
    animation: sheet-fade 0.3s var(--ease) both;
  }
  .sheet {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: var(--s-1) var(--pad) calc(var(--s-4) + env(safe-area-inset-bottom));
    background: var(--paper);
    color: var(--ink);
    border-radius: 24px 24px 0 0;
    animation: sheet-up 0.4s var(--ease) both;
    touch-action: none;
  }
  .grab {
    width: 40px;
    height: 4px;
    margin: var(--s-1) auto var(--s-3);
    border-radius: 2px;
    background: var(--hairline-strong);
  }
  .sheet-links {
    display: block;
  }
  .sheet-links a {
    display: block;
    padding: var(--s-1) 0;
    font-family: var(--font-display);
    font-size: 48px;
    font-weight: 560;
    letter-spacing: -0.03em;
    line-height: 1.1;
    text-decoration: none;
    color: var(--green);
  }
  .sheet-foot {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-2);
    margin-top: var(--s-4);
    padding-top: var(--s-3);
    border-top: 1px solid var(--hairline);
    font-size: 14px;
    color: var(--mist);
  }
  .sheet-close {
    display: block;
    width: 100%;
    min-height: 48px;
    margin-top: var(--s-3);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-pill);
    background: none;
    color: var(--ink);
    font: 600 15px var(--font-body);
  }
  .sheet-root.closing .sheet {
    animation: sheet-down 0.3s var(--ease) both;
  }
  .sheet-root.closing .backdrop {
    animation: sheet-fade-out 0.3s var(--ease) both;
  }
  @keyframes sheet-up {
    from {
      transform: translateY(100%);
    }
  }
  @keyframes sheet-down {
    to {
      transform: translateY(100%);
    }
  }
  @keyframes sheet-fade {
    from {
      opacity: 0;
    }
  }
  @keyframes sheet-fade-out {
    to {
      opacity: 0;
    }
  }
</style>

<script>
  // Live Riga clock, updates every minute.
  const tick = () => {
    const now = new Date();
    const hm = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Riga', hour: '2-digit', minute: '2-digit', hour12: false }).format(now);
    const off = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Riga', timeZoneName: 'shortOffset' })
      .formatToParts(now)
      .find((p) => p.type === 'timeZoneName')?.value;
    document.querySelectorAll('[data-riga-time]').forEach((t) => {
      t.textContent = hm;
      t.setAttribute('datetime', now.toISOString());
    });
    if (off) document.querySelectorAll('[data-riga-zone]').forEach((z) => (z.textContent = off));
  };
  tick();
  setInterval(tick, 60_000);

  // The glass appears once the page has slid over the hero
  const navEl = document.querySelector<HTMLElement>('[data-nav]');
  let navTick = false;
  const glass = () => {
    navTick = false;
    navEl?.classList.toggle('glass', scrollY > innerHeight * 0.55);
  };
  addEventListener('scroll', () => { if (!navTick) { navTick = true; requestAnimationFrame(glass); } }, { passive: true });
  glass();

  // Tone: when anything dark (the night section, dark screenshots) passes under the bar, the text turns paper.
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  if (nav) {
    const dark = new Set<Element>();
    const apply = () => nav.classList.toggle('on-dark', dark.size > 0);
    const watch = () => {
      const strip = nav.offsetHeight;
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) (e.isIntersecting ? dark.add(e.target) : dark.delete(e.target));
          apply();
        },
        { rootMargin: `0px 0px ${-(innerHeight - strip)}px 0px`, threshold: 0 },
      );
      document.querySelectorAll('[data-tone="dark"]').forEach((el) => io.observe(el));
    };
    requestAnimationFrame(watch);
  }

  // Bottom-sheet menu (phones): tap outside, swipe down, Escape or a link closes it.
  const root = document.querySelector<HTMLElement>('[data-sheet-root]');
  const sheet = document.querySelector<HTMLElement>('[data-sheet]');
  const opener = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  if (root && sheet && opener) {
    const open = () => {
      root.hidden = false;
      root.classList.remove('closing');
      opener.setAttribute('aria-expanded', 'true');
      document.documentElement.style.overflow = 'hidden';
      sheet.querySelector<HTMLElement>('a')?.focus();
    };
    const close = () => {
      if (root.hidden) return;
      root.classList.add('closing');
      opener.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
      setTimeout(() => {
        root.hidden = true;
        root.classList.remove('closing');
        sheet.style.transform = '';
      }, 280);
      opener.focus();
    };
    opener.addEventListener('click', open);
    root.querySelectorAll('[data-menu-close]').forEach((el) => el.addEventListener('click', close));
    addEventListener('keydown', (e) => e.key === 'Escape' && close());
    let y0 = 0;
    let dy = 0;
    sheet.addEventListener('touchstart', (e) => {
      y0 = e.touches[0]!.clientY;
      dy = 0;
    }, { passive: true });
    sheet.addEventListener('touchmove', (e) => {
      dy = Math.max(0, e.touches[0]!.clientY - y0);
      sheet.style.transform = `translateY(${dy}px)`;
    }, { passive: true });
    sheet.addEventListener('touchend', () => {
      if (dy > 90) close();
      else sheet.style.transform = '';
    });
    matchMedia('(min-width: 900px)').addEventListener('change', (m) => m.matches && close());
  }
</script>
