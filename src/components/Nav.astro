---
import { copy } from '../content/copy';
const { nav } = copy;
---

<header class="nav" data-nav>
  <div class="in">
    <div class="bar">
      <a class="name" href="#top">{nav.name}</a>
      <nav aria-label="Primary">
        <ul>
          {nav.links.map((l) => (
            <li><a class="roll" href={l.href} data-text={l.label}><span>{l.label}</span></a></li>
          ))}
        </ul>
      </nav>
      <a class="touch" href={nav.cta.href}>{nav.cta.label}</a>
    </div>
    <div class="meta">
      <span>{nav.role}</span>
      <span class="clock"
        >{nav.city} <time id="riga-time" datetime=""></time> <span id="riga-zone">GMT+2</span></span
      >
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    font-size: var(--fs-meta);
    font-weight: 500;
    color: var(--ink);
    transition: color 0.4s var(--ease);
  }
  /* Bar background fades in once the page scrolls (opacity only). */
  .nav::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 80px;
    background: rgb(238 233 227 / 0.78);
    backdrop-filter: blur(14px);
    opacity: 0;
    transition: opacity 0.35s var(--ease), background-color 0.4s var(--ease);
  }
  .nav.scrolled::before {
    opacity: 1;
  }
  .nav.on-night {
    color: var(--paper);
  }
  .nav.on-night::before {
    background: rgb(23 24 26 / 0.7);
  }
  .in {
    position: relative;
    max-width: var(--max);
    margin-inline: auto;
    padding: var(--s-3) var(--pad) 0;
  }
  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--s-3);
  }
  .name {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 500;
    text-decoration: none;
    justify-self: start;
  }
  ul {
    display: flex;
    gap: var(--s-4);
  }
  nav a {
    text-decoration: none;
  }
  /* Letters roll up and are replaced by the same word (two stacked copies). */
  .roll {
    position: relative;
    display: inline-block;
    overflow: hidden;
    line-height: 1.5;
  }
  .roll span {
    display: block;
    transition: transform 0.45s var(--ease);
  }
  .roll::after {
    content: attr(data-text);
    position: absolute;
    left: 0;
    top: 100%;
    transition: transform 0.45s var(--ease);
  }
  .roll:hover span,
  .roll:focus-visible span {
    transform: translateY(-100%);
  }
  .roll:hover::after,
  .roll:focus-visible::after {
    transform: translateY(-100%);
  }
  .touch {
    justify-self: end;
    padding: 10px var(--s-2);
    border: 1px solid currentColor;
    border-radius: var(--radius-pill);
    text-decoration: none;
    font-weight: 600;
    transition: background-color 0.3s var(--ease), color 0.3s var(--ease);
  }
  .touch:hover {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .on-night .touch:hover {
    background: var(--paper);
    color: var(--ink);
    border-color: var(--paper);
  }
  .meta {
    display: flex;
    justify-content: space-between;
    margin-top: var(--s-3);
    font-size: 13px;
    transition: opacity 0.3s var(--ease);
  }
  .nav.scrolled .meta {
    opacity: 0;
    pointer-events: none;
  }
  .clock {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .nav.on-night :global(:focus-visible) {
    outline-color: var(--paper);
  }
  @media (max-width: 899px) {
    .bar {
      grid-template-columns: 1fr auto;
    }
    nav {
      display: none;
    }
  }
</style>

<script>
  // Live Riga clock, updates every minute.
  const t = document.getElementById('riga-time');
  const z = document.getElementById('riga-zone');
  const tick = () => {
    if (!t || !z) return;
    const now = new Date();
    t.textContent = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Riga', hour: '2-digit', minute: '2-digit', hour12: false }).format(now);
    t.setAttribute('datetime', now.toISOString());
    const off = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Riga', timeZoneName: 'shortOffset' })
      .formatToParts(now)
      .find((p) => p.type === 'timeZoneName')?.value;
    if (off) z.textContent = off;
  };
  tick();
  setInterval(tick, 60_000);

  // Bar background after scrolling; paper text while over the dark contact section.
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const night = document.querySelector<HTMLElement>('#contact');
  let ticking = false;
  const update = () => {
    ticking = false;
    if (!nav) return;
    nav.classList.toggle('scrolled', scrollY > 40);
    nav.classList.toggle('on-night', !!night && night.getBoundingClientRect().top <= 40);
  };
  addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    },
    { passive: true },
  );
  update();
</script>
