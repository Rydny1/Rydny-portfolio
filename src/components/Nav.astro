---
import { copy } from '../content/copy';
const { nav } = copy;
---

<header class="nav">
  <div class="bar">
    <a class="name" href="#top">{nav.name}</a>
    <nav aria-label="Primary">
      <ul>
        {nav.links.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <a class="touch" href={nav.cta.href}>{nav.cta.label}</a>
  </div>
  <div class="meta">
    <span>{nav.role}</span>
    <span class="clock"
      >{nav.city} <time id="riga-time" datetime=""></time> <span id="riga-zone">GMT+2</span></span
    >
  </div>
</header>

<style>
  .nav {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 5;
    max-width: var(--max);
    margin-inline: auto;
    padding: var(--s-3) var(--pad) 0;
    font-size: var(--fs-meta);
    font-weight: 500;
  }
  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--s-3);
  }
  .name {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 500;
    text-decoration: none;
    justify-self: start;
  }
  ul {
    display: flex;
    gap: var(--s-4);
  }
  nav a {
    text-decoration: none;
  }
  .touch {
    justify-self: end;
    padding: 10px var(--s-2);
    border: 1px solid var(--ink);
    border-radius: var(--radius-pill);
    text-decoration: none;
    font-weight: 600;
  }
  .touch:hover {
    background: var(--ink);
    color: var(--paper);
  }
  .meta {
    display: flex;
    justify-content: space-between;
    margin-top: var(--s-3);
    font-size: 13px;
  }
  .clock {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  @media (max-width: 899px) {
    .bar {
      grid-template-columns: 1fr auto;
    }
    nav {
      display: none;
    }
  }
</style>

<script>
  // Live Riga clock, updates every minute.
  const t = document.getElementById('riga-time');
  const z = document.getElementById('riga-zone');
  const tick = () => {
    if (!t || !z) return;
    const now = new Date();
    t.textContent = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Riga', hour: '2-digit', minute: '2-digit', hour12: false }).format(now);
    t.setAttribute('datetime', now.toISOString());
    const off = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Riga', timeZoneName: 'shortOffset' })
      .formatToParts(now)
      .find((p) => p.type === 'timeZoneName')?.value;
    if (off) z.textContent = off;
  };
  tick();
  setInterval(tick, 60_000);
</script>
