---
import { copy } from '../content/copy';
const { fix } = copy;
---

<section class="fix" id="fix" aria-labelledby="fix-title" data-node>
  <div class="wrap">
    <div class="head">
      <h2 id="fix-title" data-title data-drift="-1">{fix.title}<span class="fs">.</span></h2>
      <p class="lead" data-words>{fix.lead}</p>
    </div>

    <ol class="rows">
      {fix.rows.map((r, i) => (
        <li class="row" data-wipex data-delay={i * 130}>
          <button class="toggle" type="button" aria-expanded="false" data-hover>
            <span class="n" aria-hidden="true">{r.n}</span>
            <span class="title">{r.title}<span class="dot" aria-hidden="true">.</span></span>
            <span class="desc">{r.text}</span>
            <span class="arrow" aria-hidden="true">→</span>
          </button>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .fix {
    padding: 40px 0 160px;
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--s-4);
    margin-bottom: 64px;
  }
  h2 {
    color: var(--green);
    font-size: var(--fs-h2);
    line-height: 0.82;
    font-weight: 560;
    letter-spacing: -0.03em;
  }
  .lead {
    font-size: 20px;
    max-width: 24ch;
  }
  .rows {
    list-style: none;
    padding: 0;
  }
  .row {
    border-top: 1px solid rgb(31 32 35 / 0.16);
  }
  .row:last-child {
    border-bottom: 1px solid rgb(31 32 35 / 0.16);
  }
  .toggle {
    display: grid;
    grid-template-columns: 90px 1fr 380px 40px;
    align-items: center;
    column-gap: var(--s-3);
    width: 100%;
    padding: 34px 0;
    border: 0;
    background: none;
    color: var(--ink);
    text-align: left;
    font: inherit;
    cursor: pointer;
  }
  .n {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    opacity: 0.5;
  }
  .title {
    font-family: var(--font-display);
    font-size: clamp(36px, 4.45vw, 64px);
    font-weight: 540;
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--ink);
    max-width: 14em;
    transition: color 0.4s var(--ease), transform 0.4s var(--ease);
  }
  .dot {
    color: var(--signal);
    display: inline-block;
    opacity: 0;
    transform: scale(0.4);
    transition: opacity 0.4s var(--ease), transform 0.4s var(--ease);
  }
  .desc {
    font-size: 17px;
    line-height: 1.6;
    opacity: 0;
    transition: opacity 0.4s var(--ease);
  }
  .arrow {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid rgb(31 32 35 / 0.3);
    border-radius: 50%;
    font-size: 16px;
    transition: background-color 0.4s var(--ease), color 0.4s var(--ease), border-color 0.4s var(--ease), transform 0.4s var(--ease);
  }

  /* Hover and keyboard focus (fine pointers): green title slides right and gains its orange full stop,
     the description fades in, the arrow fills ink */
  @media (hover: hover) and (min-width: 900px) {
    .row:hover .title,
    .toggle:focus-visible .title,
    .row.open .title {
      color: var(--green);
      transform: translateX(24px);
    }
    .row:hover .dot,
    .toggle:focus-visible .dot,
    .row.open .dot {
      opacity: 1;
      transform: none;
    }
    .row:hover .desc,
    .toggle:focus-visible .desc,
    .row.open .desc {
      opacity: 1;
    }
    .row:hover .arrow,
    .toggle:focus-visible .arrow,
    .row.open .arrow {
      background: var(--ink);
      color: var(--paper);
      border-color: var(--ink);
    }
  }

  /* Touch and narrow screens: tap-to-open accordion */
  @media (hover: none), (max-width: 899px) {
    .fix {
      padding: var(--s-4) 0 var(--section-y);
    }
    .head {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--s-2);
      margin-bottom: var(--s-4);
    }
    .toggle {
      grid-template-columns: 32px 1fr 40px;
      grid-template-areas: 'n title arrow' '. desc desc';
      column-gap: var(--s-2);
      padding: var(--s-3) 0;
    }
    .n {
      grid-area: n;
    }
    .title {
      grid-area: title;
      font-size: clamp(28px, 8vw, 40px);
    }
    .arrow {
      grid-area: arrow;
    }
    .desc {
      grid-area: desc;
      opacity: 1;
      font-size: 15px;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.4s var(--ease), padding 0.4s var(--ease);
    }
    .row.open .desc {
      max-height: 12em;
      padding-top: var(--s-2);
    }
    .row.open .arrow {
      transform: rotate(90deg);
      background: var(--ink);
      color: var(--paper);
      border-color: var(--ink);
    }
    .row.open .title {
      color: var(--green);
    }
    .row.open .dot {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.fix .toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const row = btn.closest('.row');
      const open = !row?.classList.contains('open');
      row?.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', String(open));
    });
  });
</script>
