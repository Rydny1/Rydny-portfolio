---
// Three steps joined by the orange line, in one row on every screen (smaller pills on phones).
// Scroll-driven (see scripts/flows.ts): step 1 turns green as the flow enters, the blue-grey light carries it to
// step 2, then step 3. Done steps keep a green outline and a tick. With reduced motion or no JS: three plain pills.
interface Props {
  steps: readonly [string, string, string];
}
const { steps } = Astro.props;
---

<ol class="flow" aria-label="How the fix works" data-flow>
  {steps.map((s, i) => (
    <>
      <li class="step" data-state="idle"><span>{s}</span></li>
      {i < steps.length - 1 && (
        <li class="line" aria-hidden="true"><i class="light"></i></li>
      )}
    </>
  ))}
</ol>

<style>
  .flow {
    display: flex;
    align-items: center;
    list-style: none;
    padding: 0;
    margin-top: 28px;
  }
  .step {
    position: relative;
    z-index: 1;
    flex: 0 1 auto;
    min-width: 0;
  }
  .step span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-1);
    padding: 8px 12px;
    border: 1px solid rgb(46 70 54 / 0.35);
    border-radius: var(--radius-pill);
    background: #f5f1ea;
    color: var(--ink);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    transition: background-color 0.35s var(--ease), color 0.35s var(--ease), border-color 0.35s var(--ease), transform 0.35s var(--ease);
  }
  .step[data-state='active'] span {
    background: var(--green);
    border-color: var(--green);
    color: var(--paper);
    transform: scale(1.08);
  }
  .step[data-state='done'] span {
    border-color: var(--green);
  }
  .step[data-state='done'] span::after {
    content: '✓';
    color: var(--green);
    font-size: 12px;
  }
  .line {
    position: relative;
    flex: 1;
    min-width: 18px;
    height: 3px;
    border-radius: 2px;
    background: var(--signal);
  }
  .light {
    position: absolute;
    left: 0;
    top: 0;
    width: 28px;
    height: 3px;
    border-radius: 2px;
    background: linear-gradient(to right, transparent, var(--glass-deep), var(--glass), var(--glass-deep), transparent);
    opacity: 0;
    transform: translateX(-28px);
    will-change: transform;
  }
  /* Reduced motion: all three read as done, no light */
  @media (prefers-reduced-motion: reduce) {
    .step span {
      border-color: var(--green);
    }
    .step span::after {
      content: '✓';
      color: var(--green);
      font-size: 12px;
    }
  }

  /* Phones: the same row, smaller pills (a stacked flow wastes space) */
  @media (max-width: 899px) {
    .flow {
      margin-top: var(--s-2);
    }
    .step span {
      padding: 6px 8px;
      font-size: 11px;
    }
    .step[data-state='done'] span::after {
      font-size: 10px;
    }
    .line {
      min-width: 8px;
    }
  }
</style>
