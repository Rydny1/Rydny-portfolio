---
// Three steps joined by the orange line, stacked vertically on every screen. Scroll-driven (see scripts/flows.ts):
// step 1 lights as the flow enters, the blue-grey light travels the line to step 2, and so on.
// With reduced motion or no JS: three plain pills.
interface Props {
  steps: readonly [string, string, string];
}
const { steps } = Astro.props;
---

<ol class="flow" aria-label="How the fix works" data-flow>
  {steps.map((s, i) => (
    <>
      <li class="step" data-state="idle"><span>{s}</span></li>
      {i < steps.length - 1 && (
        <li class="line" aria-hidden="true"><i class="light"></i></li>
      )}
    </>
  ))}
</ol>

<style>
  .flow {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    list-style: none;
    padding: 0;
    margin-top: var(--s-4);
  }
  .step {
    position: relative;
    z-index: 1;
  }
  .step span {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    min-height: 40px;
    padding: 0 var(--s-2);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-pill);
    background: var(--paper-raised);
    color: var(--ink);
    font-size: 13px;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    transform-origin: left center;
    transition: background-color 0.35s var(--ease), color 0.35s var(--ease), border-color 0.35s var(--ease), transform 0.35s var(--ease);
  }
  .step[data-state='active'] span {
    background: var(--green);
    border-color: var(--green);
    color: var(--paper);
    transform: scale(1.08);
  }
  .step[data-state='done'] span {
    border-color: var(--green);
  }
  .step[data-state='done'] span::after {
    content: '✓';
    color: var(--green);
    font-size: 12px;
  }
  .line {
    position: relative;
    width: 2px;
    height: 24px;
    margin-left: var(--s-3);
    background: var(--signal);
  }
  .light {
    position: absolute;
    left: -0.5px;
    top: 0;
    width: 3px;
    height: 28px;
    border-radius: 2px;
    background: linear-gradient(to bottom, transparent, var(--glass-deep), var(--glass), var(--glass-deep), transparent);
    opacity: 0;
    transform: translateY(-28px);
    will-change: transform;
  }
  /* Reduced motion: all three read as done, no light */
  @media (prefers-reduced-motion: reduce) {
    .step span {
      border-color: var(--green);
    }
    .step span::after {
      content: '✓';
      color: var(--green);
      font-size: 12px;
    }
  }
</style>
